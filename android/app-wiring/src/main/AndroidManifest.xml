<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 16E: the daily reminder. Asked only when the learner turns the reminder on (Android 13+); the reboot signal is
         received only while the reminder is on (its receiver is disabled otherwise). No exact-alarm permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:name=".CoachApplication"
        android:allowBackup="false"
        android:label="Learning Coach"
        android:supportsRtl="true"
        android:theme="@style/Theme.Coach">
        <activity
            android:windowSoftInputMode="adjustResize"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 16E: the app's own reminder alarm, reached only through its own PendingIntent. -->
        <receiver
            android:name=".ReminderAlarmReceiver"
            android:exported="false" />
        <!-- 16E: reboot, app update and clock changes clear or move an alarm; armed again from the stored setting. -->
        <receiver
            android:name=".ReminderRearmReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
