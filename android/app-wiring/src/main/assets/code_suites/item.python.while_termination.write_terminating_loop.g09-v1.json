{
  "format": "code_test_suite/1",
  "suite": "codetest.python.while_termination.write_terminating_loop.g09@v1",
  "item": "item.python.while_termination.write_terminating_loop.g09@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "no_interest_growth",
      "stdin": "1000\n300\n1\n",
      "expected_stdout": "4\n"
    },
    {
      "id": "one_month",
      "stdin": "50\n100\n10\n",
      "expected_stdout": "1\n"
    },
    {
      "id": "with_interest",
      "stdin": "1000\n200\n10\n",
      "expected_stdout": "8\n"
    }
  ]
}
