{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.f03@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.f03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nstok = {\"kalem\": 12, \"silgi\": 3}\nprint(sorted(cozum.stok_ekle(stok, sys.argv[1], int(sys.argv[2])).items()))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "existing",
      "args": [
        "kalem",
        "5"
      ],
      "expected_stdout": "[('kalem', 17), ('silgi', 3)]\n"
    },
    {
      "id": "new",
      "args": [
        "defter",
        "4"
      ],
      "expected_stdout": "[('defter', 4), ('kalem', 12), ('silgi', 3)]\n"
    }
  ]
}
