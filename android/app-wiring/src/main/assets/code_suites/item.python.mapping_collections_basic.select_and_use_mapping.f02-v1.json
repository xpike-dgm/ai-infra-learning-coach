{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.f02@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.f02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(sorted(cozum.uzunluga_gore(sys.argv[1:]).items()))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "mixed",
      "args": [
        "su",
        "çay",
        "at",
        "kahve"
      ],
      "expected_stdout": "[(2, 2), (3, 1), (5, 1)]\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "[]\n"
    },
    {
      "id": "all_same_length",
      "args": [
        "elma",
        "kivi",
        "erik"
      ],
      "expected_stdout": "[(4, 3)]\n"
    }
  ]
}
