{
  "format": "code_test_suite/1",
  "suite": "codetest.python.list_operations.select_and_use_sequence.f04@v1",
  "item": "item.python.list_operations.select_and_use_sequence.f04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nsayilar = [int(x) for x in sys.argv[1:]]\nprint(cozum.ikinci_buyuk(sayilar), sayilar)"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three",
      "args": [
        "4",
        "9",
        "7"
      ],
      "expected_stdout": "7 [4, 9, 7]\n"
    },
    {
      "id": "duplicates",
      "args": [
        "5",
        "5",
        "3"
      ],
      "expected_stdout": "5 [5, 5, 3]\n"
    },
    {
      "id": "four",
      "args": [
        "10",
        "1",
        "5",
        "8"
      ],
      "expected_stdout": "8 [10, 1, 5, 8]\n"
    },
    {
      "id": "two",
      "args": [
        "1",
        "2"
      ],
      "expected_stdout": "1 [1, 2]\n"
    }
  ]
}
