{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.g02@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.g02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nd = {}\nfor x in sys.argv[1:]:\n    k, v = x.split(\"=\")\n    d[k] = int(v)\nprint(cozum.toplam_deger(d))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two",
      "args": [
        "a=2",
        "b=5"
      ],
      "expected_stdout": "7\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "0\n"
    },
    {
      "id": "negative",
      "args": [
        "x=-3",
        "y=3",
        "z=10"
      ],
      "expected_stdout": "10\n"
    }
  ]
}
