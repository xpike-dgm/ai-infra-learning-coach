{
  "format": "code_test_suite/1",
  "suite": "codetest.python.while_termination.write_terminating_loop.g05@v1",
  "item": "item.python.while_termination.write_terminating_loop.g05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three_tries",
      "stdin": "50\n20\n37\n",
      "expected_stdout": "küçük\nbüyük\nBildin! 3 denemede\n"
    },
    {
      "id": "first_try",
      "stdin": "37\n",
      "expected_stdout": "Bildin! 1 denemede\n"
    },
    {
      "id": "close",
      "stdin": "36\n38\n37\n",
      "expected_stdout": "büyük\nküçük\nBildin! 3 denemede\n"
    }
  ]
}
