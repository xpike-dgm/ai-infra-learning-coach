{
  "format": "code_test_suite/1",
  "suite": "codetest.python.for_iteration.iterate_sequence.f03@v1",
  "item": "item.python.for_iteration.iterate_sequence.f03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "merhaba",
      "stdin": "merhaba\n",
      "expected_stdout": "3\n"
    },
    {
      "id": "turkish_vowels",
      "stdin": "gözlük\n",
      "expected_stdout": "2\n"
    },
    {
      "id": "dotless_i",
      "stdin": "ılık\n",
      "expected_stdout": "2\n"
    },
    {
      "id": "none",
      "stdin": "xyz\n",
      "expected_stdout": "0\n"
    }
  ]
}
