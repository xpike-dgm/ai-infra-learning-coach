{
  "format": "code_test_suite/1",
  "suite": "codetest.python.input_output_basic.build_small_io_flow.t01@v1",
  "item": "item.python.input_output_basic.build_small_io_flow.t01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "example",
      "stdin": "Ada Lovelace\n",
      "expected_stdout": "Lovelace, Ada\n"
    },
    {
      "id": "turkish",
      "stdin": "Cahit Arf\n",
      "expected_stdout": "Arf, Cahit\n"
    },
    {
      "id": "short",
      "stdin": "Al Bo\n",
      "expected_stdout": "Bo, Al\n"
    }
  ]
}
