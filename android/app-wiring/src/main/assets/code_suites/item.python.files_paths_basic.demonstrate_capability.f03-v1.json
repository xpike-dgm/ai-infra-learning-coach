{
  "format": "code_test_suite/1",
  "suite": "codetest.python.files_paths_basic.demonstrate_capability.f03@v1",
  "item": "item.python.files_paths_basic.demonstrate_capability.f03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, tempfile, cozum\nfrom pathlib import Path\nwith tempfile.TemporaryDirectory() as d:\n    yol = Path(d) / \"gunluk.txt\"\n    if sys.argv[1] == \"var\":\n        yol.write_bytes(\"açılış\".encode(\"utf-8\") + bytes([10]))\n    for olay in sys.argv[2:]:\n        cozum.kayit_ekle(yol, olay)\n    print(yol.read_text(encoding=\"utf-8\").splitlines())"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "keeps_old",
      "args": [
        "var",
        "giriş",
        "çıkış"
      ],
      "expected_stdout": "['açılış', 'giriş', 'çıkış']\n"
    },
    {
      "id": "creates",
      "args": [
        "yok",
        "ilk"
      ],
      "expected_stdout": "['ilk']\n"
    },
    {
      "id": "three_appends",
      "args": [
        "yok",
        "a",
        "b",
        "c"
      ],
      "expected_stdout": "['a', 'b', 'c']\n"
    }
  ]
}
