{
  "format": "code_test_suite/1",
  "suite": "codetest.python.while_termination.write_terminating_loop.g10@v1",
  "item": "item.python.while_termination.write_terminating_loop.g10@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three_rounds",
      "stdin": "9875\n",
      "expected_stdout": "2\n"
    },
    {
      "id": "single_digit",
      "stdin": "7\n",
      "expected_stdout": "7\n"
    },
    {
      "id": "one_round",
      "stdin": "23\n",
      "expected_stdout": "5\n"
    },
    {
      "id": "nines",
      "stdin": "999\n",
      "expected_stdout": "9\n"
    },
    {
      "id": "passes_ten",
      "stdin": "19\n",
      "expected_stdout": "1\n"
    }
  ]
}
