{
  "format": "code_test_suite/1",
  "suite": "codetest.python.list_operations.select_and_use_sequence.f03@v1",
  "item": "item.python.list_operations.select_and_use_sequence.f03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nliste = [int(x) for x in sys.argv[2:]]\nyeni = cozum.eklenmis(liste, int(sys.argv[1]))\nprint(yeni, liste)"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two_items",
      "args": [
        "3",
        "1",
        "2"
      ],
      "expected_stdout": "[1, 2, 3] [1, 2]\n"
    },
    {
      "id": "empty",
      "args": [
        "9"
      ],
      "expected_stdout": "[9] []\n"
    },
    {
      "id": "three_items",
      "args": [
        "0",
        "5",
        "6",
        "7"
      ],
      "expected_stdout": "[5, 6, 7, 0] [5, 6, 7]\n"
    }
  ]
}
