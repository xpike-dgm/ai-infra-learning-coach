{
  "format": "code_test_suite/1",
  "suite": "codetest.c.standard_io_basic.demonstrate_capability.g08@v1",
  "item": "item.c.standard_io_basic.demonstrate_capability.g08@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "valid",
      "stdin": "7\n",
      "expected_stdout": "Ay: 7\n",
      "expected_exit_code": 0
    },
    {
      "id": "too_big",
      "stdin": "13\n",
      "expected_stdout": "Gecersiz ay\n",
      "expected_exit_code": 1
    },
    {
      "id": "zero",
      "stdin": "0\n",
      "expected_stdout": "Gecersiz ay\n",
      "expected_exit_code": 1
    },
    {
      "id": "not_number",
      "stdin": "mart\n",
      "expected_stdout": "Gecersiz ay\n",
      "expected_exit_code": 1
    },
    {
      "id": "boundary",
      "stdin": "12\n",
      "expected_stdout": "Ay: 12\n",
      "expected_exit_code": 0
    }
  ]
}
