{
  "format": "code_test_suite/1",
  "suite": "codetest.c.while_iteration.demonstrate_capability.g04@v1",
  "item": "item.c.while_iteration.demonstrate_capability.g04@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "twelve_eighteen",
      "stdin": "12 18\n",
      "expected_stdout": "6\n"
    },
    {
      "id": "coprime",
      "stdin": "17 5\n",
      "expected_stdout": "1\n"
    },
    {
      "id": "multiple",
      "stdin": "100 25\n",
      "expected_stdout": "25\n"
    }
  ]
}
