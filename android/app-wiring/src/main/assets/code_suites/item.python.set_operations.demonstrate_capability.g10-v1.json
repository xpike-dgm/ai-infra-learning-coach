{
  "format": "code_test_suite/1",
  "suite": "codetest.python.set_operations.demonstrate_capability.g10@v1",
  "item": "item.python.set_operations.demonstrate_capability.g10@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nayrac = sys.argv.index(\"|\")\nprint(\"[\" + cozum.karsilastir([int(x) for x in sys.argv[1:ayrac]], [int(x) for x in sys.argv[ayrac + 1:]]) + \"]\")"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "example",
      "args": [
        "1",
        "2",
        "2",
        "3",
        "|",
        "3",
        "4"
      ],
      "expected_stdout": "[ortak=1 yalniz_a=2 yalniz_b=1]\n"
    },
    {
      "id": "same",
      "args": [
        "5",
        "6",
        "|",
        "6",
        "5",
        "5"
      ],
      "expected_stdout": "[ortak=2 yalniz_a=0 yalniz_b=0]\n"
    },
    {
      "id": "empty_b",
      "args": [
        "7",
        "7",
        "|"
      ],
      "expected_stdout": "[ortak=0 yalniz_a=1 yalniz_b=0]\n"
    }
  ]
}
