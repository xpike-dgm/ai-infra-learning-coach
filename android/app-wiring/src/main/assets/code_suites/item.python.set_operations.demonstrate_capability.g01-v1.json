{
  "format": "code_test_suite/1",
  "suite": "codetest.python.set_operations.demonstrate_capability.g01@v1",
  "item": "item.python.set_operations.demonstrate_capability.g01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nayrac = sys.argv.index(\"|\")\nprint(cozum.birlesim([int(x) for x in sys.argv[1:ayrac]], [int(x) for x in sys.argv[ayrac + 1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "overlap",
      "args": [
        "3",
        "1",
        "|",
        "1",
        "5"
      ],
      "expected_stdout": "[1, 3, 5]\n"
    },
    {
      "id": "repeats",
      "args": [
        "2",
        "2",
        "|",
        "2"
      ],
      "expected_stdout": "[2]\n"
    },
    {
      "id": "empty",
      "args": [
        "|"
      ],
      "expected_stdout": "[]\n"
    }
  ]
}
