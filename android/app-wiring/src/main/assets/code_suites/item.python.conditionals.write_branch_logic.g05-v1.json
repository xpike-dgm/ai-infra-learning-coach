{
  "format": "code_test_suite/1",
  "suite": "codetest.python.conditionals.write_branch_logic.g05@v1",
  "item": "item.python.conditionals.write_branch_logic.g05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "first",
      "stdin": "3\n4\n",
      "expected_stdout": "1. bölge\n"
    },
    {
      "id": "second",
      "stdin": "-2\n5\n",
      "expected_stdout": "2. bölge\n"
    },
    {
      "id": "third",
      "stdin": "-1\n-1\n",
      "expected_stdout": "3. bölge\n"
    },
    {
      "id": "fourth",
      "stdin": "6\n-3\n",
      "expected_stdout": "4. bölge\n"
    },
    {
      "id": "on_y_axis",
      "stdin": "0\n7\n",
      "expected_stdout": "eksen\n"
    },
    {
      "id": "origin",
      "stdin": "0\n0\n",
      "expected_stdout": "eksen\n"
    }
  ]
}
