{
  "format": "code_test_suite/1",
  "suite": "codetest.python.tuple_immutable_sequence.demonstrate_capability.g01@v1",
  "item": "item.python.tuple_immutable_sequence.demonstrate_capability.g01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.kare_kup(int(sys.argv[1])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two",
      "args": [
        "2"
      ],
      "expected_stdout": "(4, 8)\n"
    },
    {
      "id": "negative",
      "args": [
        "-3"
      ],
      "expected_stdout": "(9, -27)\n"
    },
    {
      "id": "zero",
      "args": [
        "0"
      ],
      "expected_stdout": "(0, 0)\n"
    }
  ]
}
