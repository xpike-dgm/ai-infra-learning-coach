{
  "format": "code_test_suite/1",
  "suite": "codetest.python.tuple_immutable_sequence.demonstrate_capability.g07@v1",
  "item": "item.python.tuple_immutable_sequence.demonstrate_capability.g07@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.koordinat_metni((int(sys.argv[1]), int(sys.argv[2]))))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "mixed",
      "args": [
        "3",
        "-4"
      ],
      "expected_stdout": "x=3, y=-4\n"
    },
    {
      "id": "origin",
      "args": [
        "0",
        "0"
      ],
      "expected_stdout": "x=0, y=0\n"
    }
  ]
}
