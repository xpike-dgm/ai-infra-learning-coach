{
  "format": "code_test_suite/1",
  "suite": "codetest.python.tuple_immutable_sequence.demonstrate_capability.g10@v1",
  "item": "item.python.tuple_immutable_sequence.demonstrate_capability.g10@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.sinifla([int(x) for x in sys.argv[1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "mixed",
      "args": [
        "70",
        "40",
        "50"
      ],
      "expected_stdout": "(2, 1)\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "(0, 0)\n"
    },
    {
      "id": "boundary",
      "args": [
        "49",
        "50"
      ],
      "expected_stdout": "(1, 1)\n"
    }
  ]
}
