{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.f04@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.f04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\na = sys.argv[1:]\nsayim = {a[i]: int(a[i + 1]) for i in range(0, len(a), 2)}\nprint(cozum.en_cok(sayim))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "tie_alphabetical",
      "args": [
        "b",
        "3",
        "a",
        "3",
        "c",
        "1"
      ],
      "expected_stdout": "a\n"
    },
    {
      "id": "clear_winner",
      "args": [
        "x",
        "1",
        "y",
        "9"
      ],
      "expected_stdout": "y\n"
    },
    {
      "id": "single",
      "args": [
        "z",
        "0"
      ],
      "expected_stdout": "z\n"
    }
  ]
}
