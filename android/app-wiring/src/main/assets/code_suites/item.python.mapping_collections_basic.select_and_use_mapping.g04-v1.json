{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.g04@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.g04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(sorted(cozum.ilk_harfe_gore(sys.argv[1:]).items()))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three",
      "args": [
        "elma",
        "armut",
        "erik"
      ],
      "expected_stdout": "[('a', ['armut']), ('e', ['elma', 'erik'])]\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "[]\n"
    },
    {
      "id": "same_letter",
      "args": [
        "kiraz",
        "kavun",
        "kivi"
      ],
      "expected_stdout": "[('k', ['kiraz', 'kavun', 'kivi'])]\n"
    }
  ]
}
