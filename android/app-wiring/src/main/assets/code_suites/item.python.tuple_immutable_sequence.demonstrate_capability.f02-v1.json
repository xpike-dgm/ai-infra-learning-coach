{
  "format": "code_test_suite/1",
  "suite": "codetest.python.tuple_immutable_sequence.demonstrate_capability.f02@v1",
  "item": "item.python.tuple_immutable_sequence.demonstrate_capability.f02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.en_kucuk_en_buyuk([int(x) for x in sys.argv[1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three",
      "args": [
        "4",
        "9",
        "1"
      ],
      "expected_stdout": "(1, 9)\n"
    },
    {
      "id": "single",
      "args": [
        "7"
      ],
      "expected_stdout": "(7, 7)\n"
    },
    {
      "id": "negatives",
      "args": [
        "-3",
        "-8",
        "-1"
      ],
      "expected_stdout": "(-8, -1)\n"
    }
  ]
}
