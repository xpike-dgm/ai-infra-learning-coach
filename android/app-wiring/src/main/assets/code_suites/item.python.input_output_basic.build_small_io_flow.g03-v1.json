{
  "format": "code_test_suite/1",
  "suite": "codetest.python.input_output_basic.build_small_io_flow.g03@v1",
  "item": "item.python.input_output_basic.build_small_io_flow.g03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "ten",
      "stdin": "10\n",
      "expected_stdout": "Sonraki: 11\nÖnceki: 9\n"
    },
    {
      "id": "zero",
      "stdin": "0\n",
      "expected_stdout": "Sonraki: 1\nÖnceki: -1\n"
    }
  ]
}
