  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "positive",
      "stdin": "5\n",
      "expected_stdout": "pozitif\n"
    },
    {
      "id": "negative",
      "stdin": "-3\n",
      "expected_stdout": "negatif\n"
    },
    {
      "id": "zero",
      "stdin": "0\n",
      "expected_stdout": "sıfır\n"
    }
  ]
}
