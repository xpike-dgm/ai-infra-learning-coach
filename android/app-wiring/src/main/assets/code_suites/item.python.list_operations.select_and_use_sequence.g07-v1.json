{
  "format": "code_test_suite/1",
  "suite": "codetest.python.list_operations.select_and_use_sequence.g07@v1",
  "item": "item.python.list_operations.select_and_use_sequence.g07@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.aralikta([int(x) for x in sys.argv[3:]], int(sys.argv[1]), int(sys.argv[2])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "inclusive",
      "args": [
        "5",
        "10",
        "1",
        "5",
        "8",
        "10"
      ],
      "expected_stdout": "3\n"
    },
    {
      "id": "none",
      "args": [
        "0",
        "2",
        "5",
        "7"
      ],
      "expected_stdout": "0\n"
    },
    {
      "id": "empty",
      "args": [
        "1",
        "9"
      ],
      "expected_stdout": "0\n"
    },
    {
      "id": "negatives",
      "args": [
        "-3",
        "0",
        "-4",
        "-3",
        "0",
        "1"
      ],
      "expected_stdout": "2\n"
    }
  ]
}
