{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.g07@v1",
  "item": "item.python.path_handling.read_write_small_text_file.g07@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.resim_mi(sys.argv[1]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "upper",
      "args": [
        "tatil/B.JPG"
      ],
      "expected_stdout": "True\n"
    },
    {
      "id": "pdf",
      "args": [
        "belge.pdf"
      ],
      "expected_stdout": "False\n"
    },
    {
      "id": "zipped",
      "args": [
        "arsiv.png.zip"
      ],
      "expected_stdout": "False\n"
    },
    {
      "id": "jpeg",
      "args": [
        "x.jpeg"
      ],
      "expected_stdout": "True\n"
    }
  ]
}
