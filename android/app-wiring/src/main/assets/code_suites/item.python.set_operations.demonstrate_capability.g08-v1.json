{
  "format": "code_test_suite/1",
  "suite": "codetest.python.set_operations.demonstrate_capability.g08@v1",
  "item": "item.python.set_operations.demonstrate_capability.g08@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\ngunler = [[]]\nfor x in sys.argv[1:]:\n    if x == \"|\":\n        gunler.append([])\n    else:\n        gunler[-1].append(x)\nprint(cozum.ziyaretci_sayisi(gunler))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three_days",
      "args": [
        "Ali",
        "Ece",
        "|",
        "Ece",
        "Can",
        "|",
        "Ali"
      ],
      "expected_stdout": "3\n"
    },
    {
      "id": "one_day",
      "args": [
        "Ali",
        "Ali"
      ],
      "expected_stdout": "1\n"
    },
    {
      "id": "empty_day",
      "args": [
        "|",
        "Can"
      ],
      "expected_stdout": "1\n"
    }
  ]
}
