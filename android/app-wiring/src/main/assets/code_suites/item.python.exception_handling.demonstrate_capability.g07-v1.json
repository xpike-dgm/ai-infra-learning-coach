{
  "format": "code_test_suite/1",
  "suite": "codetest.python.exception_handling.demonstrate_capability.g07@v1",
  "item": "item.python.exception_handling.demonstrate_capability.g07@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\ntry:\n    print(cozum.pozitif_sayi(sys.argv[1]))\nexcept ValueError as e:\n    print(\"ValueError:\", e)"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "ok",
      "args": [
        "7"
      ],
      "expected_stdout": "7\n"
    },
    {
      "id": "zero",
      "args": [
        "0"
      ],
      "expected_stdout": "ValueError: pozitif olmalı\n"
    },
    {
      "id": "negative",
      "args": [
        "-2"
      ],
      "expected_stdout": "ValueError: pozitif olmalı\n"
    },
    {
      "id": "not_a_number",
      "args": [
        "yedi"
      ],
      "expected_stdout": "ValueError: invalid literal for int() with base 10: 'yedi'\n"
    }
  ]
}
