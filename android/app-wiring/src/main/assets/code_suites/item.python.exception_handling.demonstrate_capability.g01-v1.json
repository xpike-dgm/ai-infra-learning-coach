{
  "format": "code_test_suite/1",
  "suite": "codetest.python.exception_handling.demonstrate_capability.g01@v1",
  "item": "item.python.exception_handling.demonstrate_capability.g01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nmetinler = [[1] if x == \"<liste>\" else x for x in sys.argv[1:]]\ntry:\n    print(cozum.ilk_sayi(metinler))\nexcept Exception as e:\n    print(\"yukarıya geldi\")"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "second",
      "args": [
        "a",
        "12",
        "5"
      ],
      "expected_stdout": "12\n"
    },
    {
      "id": "none",
      "args": [
        "x",
        "y"
      ],
      "expected_stdout": "None\n"
    },
    {
      "id": "negative_first",
      "args": [
        "-3",
        "8"
      ],
      "expected_stdout": "-3\n"
    },
    {
      "id": "wrong_type_propagates",
      "args": [
        "a",
        "<liste>",
        "4"
      ],
      "expected_stdout": "yukarıya geldi\n"
    }
  ]
}
