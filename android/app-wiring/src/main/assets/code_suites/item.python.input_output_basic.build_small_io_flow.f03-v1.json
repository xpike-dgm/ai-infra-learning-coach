{
  "format": "code_test_suite/1",
  "suite": "codetest.python.input_output_basic.build_small_io_flow.f03@v1",
  "item": "item.python.input_output_basic.build_small_io_flow.f03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three_items",
      "stdin": "40\n3\n",
      "expected_stdout": "Tutar: 120\n"
    },
    {
      "id": "one_item",
      "stdin": "15\n1\n",
      "expected_stdout": "Tutar: 15\n"
    },
    {
      "id": "zero_items",
      "stdin": "99\n0\n",
      "expected_stdout": "Tutar: 0\n"
    }
  ]
}
