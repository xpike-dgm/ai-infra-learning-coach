{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.g09@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.g09@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nd = {}\nfor x in sys.argv[1:]:\n    k, v = x.split(\"=\")\n    d[k] = int(v)\nprint(sorted(cozum.degere_gore(d).items()))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "shared",
      "args": [
        "ece=2",
        "can=1",
        "ali=2"
      ],
      "expected_stdout": "[(1, ['can']), (2, ['ali', 'ece'])]\n"
    },
    {
      "id": "unique",
      "args": [
        "a=5"
      ],
      "expected_stdout": "[(5, ['a'])]\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "[]\n"
    }
  ]
}
