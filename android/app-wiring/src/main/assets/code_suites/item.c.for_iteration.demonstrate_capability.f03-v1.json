{
  "format": "code_test_suite/1",
  "suite": "codetest.c.for_iteration.demonstrate_capability.f03@v1",
  "item": "item.c.for_iteration.demonstrate_capability.f03@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "five",
      "stdin": "5\n",
      "expected_stdout": "120\n"
    },
    {
      "id": "zero",
      "stdin": "0\n",
      "expected_stdout": "1\n"
    },
    {
      "id": "one",
      "stdin": "1\n",
      "expected_stdout": "1\n"
    },
    {
      "id": "twenty",
      "stdin": "20\n",
      "expected_stdout": "2432902008176640000\n"
    }
  ]
}
