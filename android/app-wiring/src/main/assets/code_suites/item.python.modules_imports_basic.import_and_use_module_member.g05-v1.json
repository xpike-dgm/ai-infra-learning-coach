{
  "format": "code_test_suite/1",
  "suite": "codetest.python.modules_imports_basic.import_and_use_module_member.g05@v1",
  "item": "item.python.modules_imports_basic.import_and_use_module_member.g05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.kac_kutu(int(sys.argv[1]), int(sys.argv[2])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "partial_box",
      "args": [
        "10",
        "4"
      ],
      "expected_stdout": "3\n"
    },
    {
      "id": "exact",
      "args": [
        "8",
        "4"
      ],
      "expected_stdout": "2\n"
    },
    {
      "id": "none",
      "args": [
        "0",
        "5"
      ],
      "expected_stdout": "0\n"
    },
    {
      "id": "one_extra",
      "args": [
        "21",
        "10"
      ],
      "expected_stdout": "3\n"
    }
  ]
}
