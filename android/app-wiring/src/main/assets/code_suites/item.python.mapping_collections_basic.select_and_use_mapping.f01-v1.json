{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.f01@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.f01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nfiyatlar = {\"elma\": 5, \"armut\": 7, \"muz\": 12}\nprint(cozum.fiyat(fiyatlar, sys.argv[1]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "present",
      "args": [
        "armut"
      ],
      "expected_stdout": "7\n"
    },
    {
      "id": "missing",
      "args": [
        "kiraz"
      ],
      "expected_stdout": "0\n"
    },
    {
      "id": "another",
      "args": [
        "muz"
      ],
      "expected_stdout": "12\n"
    }
  ]
}
