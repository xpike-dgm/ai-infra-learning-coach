{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.f04@v1",
  "item": "item.python.path_handling.read_write_small_text_file.f04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.uzanti_degistir(sys.argv[1], sys.argv[2]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "simple",
      "args": [
        "notlar/ders.txt",
        ".md"
      ],
      "expected_stdout": "notlar/ders.md\n"
    },
    {
      "id": "folder_has_dot",
      "args": [
        "eski.txt/ders.txt",
        ".md"
      ],
      "expected_stdout": "eski.txt/ders.md\n"
    },
    {
      "id": "two_dots",
      "args": [
        "yedek/veri.tar.gz",
        ".zip"
      ],
      "expected_stdout": "yedek/veri.tar.zip\n"
    }
  ]
}
