{
  "format": "code_test_suite/1",
  "suite": "codetest.python.list_operations.select_and_use_sequence.t01@v1",
  "item": "item.python.list_operations.select_and_use_sequence.t01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.sirali_kelimeler(sys.argv[1]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three",
      "args": [
        "kiraz elma armut"
      ],
      "expected_stdout": "['armut', 'elma', 'kiraz']\n"
    },
    {
      "id": "one",
      "args": [
        "tek"
      ],
      "expected_stdout": "['tek']\n"
    },
    {
      "id": "sorted_already",
      "args": [
        "a b c"
      ],
      "expected_stdout": "['a', 'b', 'c']\n"
    }
  ]
}
