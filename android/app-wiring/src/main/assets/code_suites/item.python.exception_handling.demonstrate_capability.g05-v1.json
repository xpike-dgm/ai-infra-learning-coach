{
  "format": "code_test_suite/1",
  "suite": "codetest.python.exception_handling.demonstrate_capability.g05@v1",
  "item": "item.python.exception_handling.demonstrate_capability.g05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nmetin = None if sys.argv[1] == \"<yok>\" else sys.argv[1]\ntry:\n    print(cozum.hata_mesaji(metin))\nexcept Exception as e:\n    print(\"yukarıya geldi\")"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "ok",
      "args": [
        "15"
      ],
      "expected_stdout": "tamam\n"
    },
    {
      "id": "word",
      "args": [
        "x"
      ],
      "expected_stdout": "invalid literal for int() with base 10: 'x'\n"
    },
    {
      "id": "decimal",
      "args": [
        "2.5"
      ],
      "expected_stdout": "invalid literal for int() with base 10: '2.5'\n"
    },
    {
      "id": "none_propagates",
      "args": [
        "<yok>"
      ],
      "expected_stdout": "yukarıya geldi\n"
    }
  ]
}
