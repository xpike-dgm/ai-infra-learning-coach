{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.g05@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.g05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nd1, d2 = {}, {}\nhedef = d1\nfor x in sys.argv[1:]:\n    if x == \"|\":\n        hedef = d2\n        continue\n    k, v = x.split(\"=\")\n    hedef[k] = int(v)\nsonuc = cozum.birlestir(d1, d2)\nprint(sorted(sonuc.items()), sorted(d1.items()))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "overlap",
      "args": [
        "a=1",
        "b=2",
        "|",
        "b=5",
        "c=7"
      ],
      "expected_stdout": "[('a', 1), ('b', 7), ('c', 7)] [('a', 1), ('b', 2)]\n"
    },
    {
      "id": "disjoint",
      "args": [
        "x=3",
        "|",
        "y=4"
      ],
      "expected_stdout": "[('x', 3), ('y', 4)] [('x', 3)]\n"
    },
    {
      "id": "empty_first",
      "args": [
        "|",
        "z=9"
      ],
      "expected_stdout": "[('z', 9)] []\n"
    }
  ]
}
