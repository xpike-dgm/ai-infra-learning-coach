{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.g11@v1",
  "item": "item.python.path_handling.read_write_small_text_file.g11@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.cikti_yolu(sys.argv[1], sys.argv[2]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "csv",
      "args": [
        "veri/olcum.csv",
        "sonuc"
      ],
      "expected_stdout": "sonuc/olcum.json\n"
    },
    {
      "id": "two_dots",
      "args": [
        "a/kayit.2026.log",
        "b/c"
      ],
      "expected_stdout": "b/c/kayit.2026.json\n"
    },
    {
      "id": "no_suffix",
      "args": [
        "veri",
        "x"
      ],
      "expected_stdout": "x/veri.json\n"
    }
  ]
}
