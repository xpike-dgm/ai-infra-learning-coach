{
  "format": "code_test_suite/1",
  "suite": "codetest.python.string_text_operations.demonstrate_capability.f02@v1",
  "item": "item.python.string_text_operations.demonstrate_capability.f02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.yuzde(sys.argv[1], float(sys.argv[2])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "example",
      "args": [
        "Deniz",
        "0.456"
      ],
      "expected_stdout": "Deniz: %45.6\n"
    },
    {
      "id": "whole",
      "args": [
        "Can",
        "1"
      ],
      "expected_stdout": "Can: %100.0\n"
    },
    {
      "id": "float_noise",
      "args": [
        "Ada",
        "0.07"
      ],
      "expected_stdout": "Ada: %7.0\n"
    }
  ]
}
