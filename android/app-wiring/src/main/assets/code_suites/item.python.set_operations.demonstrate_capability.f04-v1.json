{
  "format": "code_test_suite/1",
  "suite": "codetest.python.set_operations.demonstrate_capability.f04@v1",
  "item": "item.python.set_operations.demonstrate_capability.f04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nayrac = sys.argv.index(\"|\")\na = [int(x) for x in sys.argv[1:ayrac]]\nb = [int(x) for x in sys.argv[ayrac + 1:]]\nprint(cozum.yalniz_ilkinde(a, b))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "basic",
      "args": [
        "5",
        "1",
        "3",
        "1",
        "|",
        "3"
      ],
      "expected_stdout": "[1, 5]\n"
    },
    {
      "id": "all_removed",
      "args": [
        "2",
        "|",
        "2",
        "4"
      ],
      "expected_stdout": "[]\n"
    },
    {
      "id": "second_empty",
      "args": [
        "7",
        "7",
        "6",
        "|"
      ],
      "expected_stdout": "[6, 7]\n"
    }
  ]
}
