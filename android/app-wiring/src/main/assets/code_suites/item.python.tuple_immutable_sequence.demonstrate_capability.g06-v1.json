{
  "format": "code_test_suite/1",
  "suite": "codetest.python.tuple_immutable_sequence.demonstrate_capability.g06@v1",
  "item": "item.python.tuple_immutable_sequence.demonstrate_capability.g06@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.ters_cevir(tuple(int(x) for x in sys.argv[1:])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three",
      "args": [
        "1",
        "2",
        "3"
      ],
      "expected_stdout": "(3, 2, 1)\n"
    },
    {
      "id": "single",
      "args": [
        "9"
      ],
      "expected_stdout": "(9,)\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "()\n"
    }
  ]
}
