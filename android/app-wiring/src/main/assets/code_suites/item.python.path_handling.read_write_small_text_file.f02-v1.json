{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.f02@v1",
  "item": "item.python.path_handling.read_write_small_text_file.f02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.govde(sys.argv[1]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "simple",
      "args": [
        "fotograflar/tatil.jpeg"
      ],
      "expected_stdout": "tatil\n"
    },
    {
      "id": "two_dots",
      "args": [
        "arsiv/kayit.2026.csv"
      ],
      "expected_stdout": "kayit.2026\n"
    },
    {
      "id": "no_folder",
      "args": [
        "okuBeni.md"
      ],
      "expected_stdout": "okuBeni\n"
    }
  ]
}
