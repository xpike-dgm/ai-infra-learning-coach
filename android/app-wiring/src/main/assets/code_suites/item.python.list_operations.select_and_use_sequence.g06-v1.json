{
  "format": "code_test_suite/1",
  "suite": "codetest.python.list_operations.select_and_use_sequence.g06@v1",
  "item": "item.python.list_operations.select_and_use_sequence.g06@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nliste = [int(x) for x in sys.argv[1:]]\ndonen = cozum.iki_katina(liste)\nprint(donen, liste)"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three",
      "args": [
        "1",
        "2",
        "3"
      ],
      "expected_stdout": "None [2, 4, 6]\n"
    },
    {
      "id": "negative",
      "args": [
        "-5",
        "0"
      ],
      "expected_stdout": "None [-10, 0]\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "None []\n"
    }
  ]
}
