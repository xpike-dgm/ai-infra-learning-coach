{
  "format": "code_test_suite/1",
  "suite": "codetest.python.exception_handling.demonstrate_capability.g09@v1",
  "item": "item.python.exception_handling.demonstrate_capability.g09@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nayrac = sys.argv.index(\"|\")\ndef deger(x):\n    return x if x == \"a\" else int(x)\ntry:\n    print(cozum.bolumler([deger(x) for x in sys.argv[1:ayrac]], [deger(x) for x in sys.argv[ayrac + 1:]]))\nexcept Exception as e:\n    print(\"yukarıya geldi\")"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "one_zero",
      "args": [
        "9",
        "5",
        "8",
        "|",
        "3",
        "0",
        "2"
      ],
      "expected_stdout": "[3, None, 4]\n"
    },
    {
      "id": "no_zero",
      "args": [
        "7",
        "|",
        "2"
      ],
      "expected_stdout": "[3]\n"
    },
    {
      "id": "all_zero",
      "args": [
        "1",
        "2",
        "|",
        "0",
        "0"
      ],
      "expected_stdout": "[None, None]\n"
    },
    {
      "id": "wrong_type_propagates",
      "args": [
        "6",
        "a",
        "|",
        "2",
        "3"
      ],
      "expected_stdout": "yukarıya geldi\n"
    }
  ]
}
