{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.f05@v1",
  "item": "item.python.path_handling.read_write_small_text_file.f05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.ayni_klasorde(sys.argv[1], sys.argv[2]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "same",
      "args": [
        "veri/a.txt",
        "veri/b.txt"
      ],
      "expected_stdout": "True\n"
    },
    {
      "id": "deeper",
      "args": [
        "veri/a.txt",
        "veri/alt/b.txt"
      ],
      "expected_stdout": "False\n"
    },
    {
      "id": "both_here",
      "args": [
        "a.txt",
        "b.txt"
      ],
      "expected_stdout": "True\n"
    },
    {
      "id": "same_name_other_folder",
      "args": [
        "x/rapor.txt",
        "y/rapor.txt"
      ],
      "expected_stdout": "False\n"
    },
    {
      "id": "same_folder_name_elsewhere",
      "args": [
        "ev/veri/a.txt",
        "is/veri/b.txt"
      ],
      "expected_stdout": "False\n"
    }
  ]
}
