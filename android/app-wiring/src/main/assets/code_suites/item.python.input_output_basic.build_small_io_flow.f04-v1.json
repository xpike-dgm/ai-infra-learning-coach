{
  "format": "code_test_suite/1",
  "suite": "codetest.python.input_output_basic.build_small_io_flow.f04@v1",
  "item": "item.python.input_output_basic.build_small_io_flow.f04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "boiling",
      "stdin": "100\n",
      "expected_stdout": "212.0\n"
    },
    {
      "id": "freezing",
      "stdin": "0\n",
      "expected_stdout": "32.0\n"
    },
    {
      "id": "same_point",
      "stdin": "-40\n",
      "expected_stdout": "-40.0\n"
    }
  ]
}
