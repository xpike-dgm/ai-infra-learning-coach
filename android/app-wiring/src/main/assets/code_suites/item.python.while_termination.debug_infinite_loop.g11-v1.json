{
  "format": "code_test_suite/1",
  "suite": "codetest.python.while_termination.debug_infinite_loop.g11@v1",
  "item": "item.python.while_termination.debug_infinite_loop.g11@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "seven",
      "stdin": "7\n",
      "expected_stdout": "7\n4\n1\n"
    },
    {
      "id": "zero",
      "stdin": "0\n",
      "expected_stdout": "0\n"
    },
    {
      "id": "negative",
      "stdin": "-1\n",
      "expected_stdout": ""
    },
    {
      "id": "six",
      "stdin": "6\n",
      "expected_stdout": "6\n3\n0\n"
    }
  ]
}
