{
  "format": "code_test_suite/1",
  "suite": "codetest.python.set_operations.demonstrate_capability.f01@v1",
  "item": "item.python.set_operations.demonstrate_capability.f01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.farkli_sayisi(sys.argv[1:]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "with_repeats",
      "args": [
        "1",
        "2",
        "2",
        "3"
      ],
      "expected_stdout": "3\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "0\n"
    },
    {
      "id": "all_same",
      "args": [
        "a",
        "a",
        "a"
      ],
      "expected_stdout": "1\n"
    }
  ]
}
