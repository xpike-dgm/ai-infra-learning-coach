{
  "format": "code_test_suite/1",
  "suite": "codetest.python.functions_parameters_return.write_small_function.g06@v1",
  "item": "item.python.functions_parameters_return.write_small_function.g06@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.isaret(int(sys.argv[1])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "positive",
      "args": [
        "12"
      ],
      "expected_stdout": "+\n"
    },
    {
      "id": "negative",
      "args": [
        "-5"
      ],
      "expected_stdout": "-\n"
    },
    {
      "id": "zero",
      "args": [
        "0"
      ],
      "expected_stdout": "0\n"
    }
  ]
}
