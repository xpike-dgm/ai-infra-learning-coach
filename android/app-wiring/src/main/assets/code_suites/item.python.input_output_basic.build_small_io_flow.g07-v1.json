{
  "format": "code_test_suite/1",
  "suite": "codetest.python.input_output_basic.build_small_io_flow.g07@v1",
  "item": "item.python.input_output_basic.build_small_io_flow.g07@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "even",
      "stdin": "3\n4\n5\n",
      "expected_stdout": "Toplam: 12 Ortalama: 4.0\n"
    },
    {
      "id": "repeating",
      "stdin": "1\n2\n2\n",
      "expected_stdout": "Toplam: 5 Ortalama: 1.67\n"
    },
    {
      "id": "one_nonzero",
      "stdin": "10\n0\n0\n",
      "expected_stdout": "Toplam: 10 Ortalama: 3.33\n"
    }
  ]
}
