{
  "format": "code_test_suite/1",
  "suite": "codetest.c.for_iteration.demonstrate_capability.g04@v1",
  "item": "item.c.for_iteration.demonstrate_capability.g04@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "twelve",
      "stdin": "12\n",
      "expected_stdout": "1 2 3 4 6 12\n"
    },
    {
      "id": "prime",
      "stdin": "7\n",
      "expected_stdout": "1 7\n"
    },
    {
      "id": "one",
      "stdin": "1\n",
      "expected_stdout": "1\n"
    }
  ]
}
