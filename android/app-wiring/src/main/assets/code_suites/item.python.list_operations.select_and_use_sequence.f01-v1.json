{
  "format": "code_test_suite/1",
  "suite": "codetest.python.list_operations.select_and_use_sequence.f01@v1",
  "item": "item.python.list_operations.select_and_use_sequence.f01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.ilk_ve_son([int(x) for x in sys.argv[1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three",
      "args": [
        "3",
        "8",
        "5"
      ],
      "expected_stdout": "[3, 5]\n"
    },
    {
      "id": "single",
      "args": [
        "7"
      ],
      "expected_stdout": "[7, 7]\n"
    },
    {
      "id": "two",
      "args": [
        "1",
        "2"
      ],
      "expected_stdout": "[1, 2]\n"
    }
  ]
}
