{
  "format": "code_test_suite/1",
  "suite": "codetest.c.for_iteration.demonstrate_capability.g01@v1",
  "item": "item.c.for_iteration.demonstrate_capability.g01@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "four",
      "stdin": "4\n",
      "expected_stdout": "****\n"
    },
    {
      "id": "one",
      "stdin": "1\n",
      "expected_stdout": "*\n"
    },
    {
      "id": "zero",
      "stdin": "0\n",
      "expected_stdout": "\n"
    }
  ]
}
