{
  "format": "code_test_suite/1",
  "suite": "codetest.python.set_operations.demonstrate_capability.f03@v1",
  "item": "item.python.set_operations.demonstrate_capability.f03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.tekrar_edenler([int(x) for x in sys.argv[1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two_repeat",
      "args": [
        "4",
        "1",
        "4",
        "2",
        "1",
        "4"
      ],
      "expected_stdout": "[1, 4]\n"
    },
    {
      "id": "none",
      "args": [
        "1",
        "2",
        "3"
      ],
      "expected_stdout": "[]\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "[]\n"
    }
  ]
}
