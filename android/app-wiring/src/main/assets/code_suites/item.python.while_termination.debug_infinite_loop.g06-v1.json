{
  "format": "code_test_suite/1",
  "suite": "codetest.python.while_termination.debug_infinite_loop.g06@v1",
  "item": "item.python.while_termination.debug_infinite_loop.g06@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "first_try",
      "stdin": "gizli\n",
      "expected_stdout": "Açıldı\n"
    },
    {
      "id": "third_try",
      "stdin": "a\nb\ngizli\n",
      "expected_stdout": "Açıldı\n"
    },
    {
      "id": "locked",
      "stdin": "a\nb\nc\nd\n",
      "expected_stdout": "Kilitlendi\n"
    },
    {
      "id": "no_fourth_try",
      "stdin": "a\nb\nc\ngizli\n",
      "expected_stdout": "Kilitlendi\n"
    }
  ]
}
