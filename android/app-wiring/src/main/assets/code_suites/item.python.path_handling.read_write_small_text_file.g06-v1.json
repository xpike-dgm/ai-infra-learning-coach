{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.g06@v1",
  "item": "item.python.path_handling.read_write_small_text_file.g06@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.kardes(sys.argv[1], sys.argv[2]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "nested",
      "args": [
        "proje/src/ana.py",
        "test.py"
      ],
      "expected_stdout": "proje/src/test.py\n"
    },
    {
      "id": "top_level",
      "args": [
        "ana.py",
        "yardim.py"
      ],
      "expected_stdout": "yardim.py\n"
    }
  ]
}
