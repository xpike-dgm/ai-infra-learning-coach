{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.g04@v1",
  "item": "item.python.path_handling.read_write_small_text_file.g04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.arsiv_yolu(sys.argv[1]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "example",
      "args": [
        "rapor/mart.xlsx"
      ],
      "expected_stdout": "rapor/arsiv/mart.xlsx.bak\n"
    },
    {
      "id": "no_folder",
      "args": [
        "notlar.txt"
      ],
      "expected_stdout": "arsiv/notlar.txt.bak\n"
    },
    {
      "id": "no_suffix",
      "args": [
        "a/b/README"
      ],
      "expected_stdout": "a/b/arsiv/README.bak\n"
    }
  ]
}
