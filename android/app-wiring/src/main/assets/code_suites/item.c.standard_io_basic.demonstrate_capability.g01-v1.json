{
  "format": "code_test_suite/1",
  "suite": "codetest.c.standard_io_basic.demonstrate_capability.g01@v1",
  "item": "item.c.standard_io_basic.demonstrate_capability.g01@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "small",
      "stdin": "4 9\n",
      "expected_stdout": "4 + 9 = 13\n"
    },
    {
      "id": "lines",
      "stdin": "10\n-3\n",
      "expected_stdout": "10 + -3 = 7\n"
    }
  ]
}
