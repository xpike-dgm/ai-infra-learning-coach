{
  "format": "code_test_suite/1",
  "suite": "codetest.python.exception_handling.demonstrate_capability.g08@v1",
  "item": "item.python.exception_handling.demonstrate_capability.g08@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\na = int(sys.argv[1])\nb = int(sys.argv[2])\ntry:\n    ic = cozum.birim_fiyat(a, b)\nexcept ZeroDivisionError:\n    ic = \"hata yukarı geçti\"\nprint(ic, cozum.rapor(a, b))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "normal",
      "args": [
        "10",
        "4"
      ],
      "expected_stdout": "2.5 2.5\n"
    },
    {
      "id": "zero",
      "args": [
        "10",
        "0"
      ],
      "expected_stdout": "hata yukarı geçti None\n"
    },
    {
      "id": "thirds",
      "args": [
        "1",
        "3"
      ],
      "expected_stdout": "0.3333333333333333 0.33\n"
    }
  ]
}
