{
  "format": "code_test_suite/1",
  "suite": "codetest.python.set_operations.demonstrate_capability.g07@v1",
  "item": "item.python.set_operations.demonstrate_capability.g07@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.hepsi_farkli_mi([int(x) for x in sys.argv[1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "distinct",
      "args": [
        "1",
        "2",
        "3"
      ],
      "expected_stdout": "True\n"
    },
    {
      "id": "repeat",
      "args": [
        "4",
        "1",
        "4"
      ],
      "expected_stdout": "False\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "True\n"
    }
  ]
}
