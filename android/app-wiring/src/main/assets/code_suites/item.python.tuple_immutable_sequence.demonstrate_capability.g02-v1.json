{
  "format": "code_test_suite/1",
  "suite": "codetest.python.tuple_immutable_sequence.demonstrate_capability.g02@v1",
  "item": "item.python.tuple_immutable_sequence.demonstrate_capability.g02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.uzunluk_ve_ilk(tuple(int(x) for x in sys.argv[1:])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three",
      "args": [
        "7",
        "8",
        "9"
      ],
      "expected_stdout": "(3, 7)\n"
    },
    {
      "id": "single",
      "args": [
        "4"
      ],
      "expected_stdout": "(1, 4)\n"
    }
  ]
}
