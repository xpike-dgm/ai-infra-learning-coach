{
  "format": "code_test_suite/1",
  "suite": "codetest.python.list_operations.select_and_use_sequence.f02@v1",
  "item": "item.python.list_operations.select_and_use_sequence.f02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.ciftler([int(x) for x in sys.argv[1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "mixed",
      "args": [
        "3",
        "4",
        "7",
        "10"
      ],
      "expected_stdout": "[4, 10]\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "[]\n"
    },
    {
      "id": "none_even",
      "args": [
        "1",
        "5"
      ],
      "expected_stdout": "[]\n"
    },
    {
      "id": "zero_and_negative",
      "args": [
        "0",
        "-2",
        "-3"
      ],
      "expected_stdout": "[0, -2]\n"
    }
  ]
}
