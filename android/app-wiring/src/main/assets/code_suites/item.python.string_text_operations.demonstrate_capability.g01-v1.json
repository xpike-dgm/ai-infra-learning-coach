{
  "format": "code_test_suite/1",
  "suite": "codetest.python.string_text_operations.demonstrate_capability.g01@v1",
  "item": "item.python.string_text_operations.demonstrate_capability.g01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(\"[\" + cozum.alt_cizgili(sys.argv[1]) + \"]\")"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two_words",
      "args": [
        "  yeni dosya  "
      ],
      "expected_stdout": "[yeni_dosya]\n"
    },
    {
      "id": "three_words",
      "args": [
        "a b c"
      ],
      "expected_stdout": "[a_b_c]\n"
    },
    {
      "id": "one_word",
      "args": [
        " tek"
      ],
      "expected_stdout": "[tek]\n"
    }
  ]
}
