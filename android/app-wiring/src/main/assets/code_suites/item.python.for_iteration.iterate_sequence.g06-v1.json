{
  "format": "code_test_suite/1",
  "suite": "codetest.python.for_iteration.iterate_sequence.g06@v1",
  "item": "item.python.for_iteration.iterate_sequence.g06@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "word",
      "stdin": "kalem\n",
      "expected_stdout": "k-a-l-e-m\n"
    },
    {
      "id": "single",
      "stdin": "a\n",
      "expected_stdout": "a\n"
    },
    {
      "id": "two",
      "stdin": "su\n",
      "expected_stdout": "s-u\n"
    }
  ]
}
