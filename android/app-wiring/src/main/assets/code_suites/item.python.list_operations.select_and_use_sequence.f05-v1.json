{
  "format": "code_test_suite/1",
  "suite": "codetest.python.list_operations.select_and_use_sequence.f05@v1",
  "item": "item.python.list_operations.select_and_use_sequence.f05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.birikimli([int(x) for x in sys.argv[1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three",
      "args": [
        "1",
        "2",
        "3"
      ],
      "expected_stdout": "[1, 3, 6]\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "[]\n"
    },
    {
      "id": "cancel",
      "args": [
        "5",
        "-5",
        "2"
      ],
      "expected_stdout": "[5, 0, 2]\n"
    },
    {
      "id": "single",
      "args": [
        "4"
      ],
      "expected_stdout": "[4]\n"
    }
  ]
}
