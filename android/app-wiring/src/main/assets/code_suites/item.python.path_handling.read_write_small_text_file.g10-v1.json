{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.g10@v1",
  "item": "item.python.path_handling.read_write_small_text_file.g10@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.python_dosyalari(sys.argv[1:]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "mixed",
      "args": [
        "src/b.py",
        "README.md",
        "test/a.py"
      ],
      "expected_stdout": "['a.py', 'b.py']\n"
    },
    {
      "id": "compiled",
      "args": [
        "x.pyc",
        "y.py"
      ],
      "expected_stdout": "['y.py']\n"
    },
    {
      "id": "none",
      "args": [
        "a.txt"
      ],
      "expected_stdout": "[]\n"
    }
  ]
}
