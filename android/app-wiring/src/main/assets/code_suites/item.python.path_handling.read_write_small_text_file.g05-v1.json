{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.g05@v1",
  "item": "item.python.path_handling.read_write_small_text_file.g05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(sorted(cozum.uzanti_sayimi(sys.argv[1:]).items()))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "mixed",
      "args": [
        "a.txt",
        "b/c.TXT",
        "d.png"
      ],
      "expected_stdout": "[('.png', 1), ('.txt', 2)]\n"
    },
    {
      "id": "no_suffix",
      "args": [
        "Makefile",
        "x/y.py"
      ],
      "expected_stdout": "[('', 1), ('.py', 1)]\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "[]\n"
    }
  ]
}
