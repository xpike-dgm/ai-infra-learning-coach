{
  "format": "code_test_suite/1",
  "suite": "codetest.python.list_operations.select_and_use_sequence.g11@v1",
  "item": "item.python.list_operations.select_and_use_sequence.g11@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nliste = [int(x) for x in sys.argv[1:]]\nyeni = cozum.sola_kaydir(liste)\nprint(yeni, liste)"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three",
      "args": [
        "1",
        "2",
        "3"
      ],
      "expected_stdout": "[2, 3, 1] [1, 2, 3]\n"
    },
    {
      "id": "single",
      "args": [
        "7"
      ],
      "expected_stdout": "[7] [7]\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "[] []\n"
    }
  ]
}
