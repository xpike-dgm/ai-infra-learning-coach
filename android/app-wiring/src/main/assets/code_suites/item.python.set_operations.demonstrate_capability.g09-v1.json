{
  "format": "code_test_suite/1",
  "suite": "codetest.python.set_operations.demonstrate_capability.g09@v1",
  "item": "item.python.set_operations.demonstrate_capability.g09@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\ngunler = [[]]\nfor x in sys.argv[1:]:\n    if x == \"|\":\n        gunler.append([])\n    else:\n        gunler[-1].append(x)\nprint(cozum.her_gun_gelen(gunler))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "one_always",
      "args": [
        "Ali",
        "Ece",
        "|",
        "Ece",
        "Can",
        "|",
        "Ece",
        "Ali"
      ],
      "expected_stdout": "['Ece']\n"
    },
    {
      "id": "single_day",
      "args": [
        "Can",
        "Ali"
      ],
      "expected_stdout": "['Ali', 'Can']\n"
    },
    {
      "id": "nobody",
      "args": [
        "Ali",
        "|",
        "Can"
      ],
      "expected_stdout": "[]\n"
    }
  ]
}
