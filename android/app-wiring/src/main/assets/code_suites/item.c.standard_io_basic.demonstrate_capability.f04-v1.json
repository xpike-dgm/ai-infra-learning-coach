{
  "format": "code_test_suite/1",
  "suite": "codetest.c.standard_io_basic.demonstrate_capability.f04@v1",
  "item": "item.c.standard_io_basic.demonstrate_capability.f04@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "example",
      "stdin": "70 85 90\n",
      "expected_stdout": "81.67\n"
    },
    {
      "id": "exact",
      "stdin": "60 60 60\n",
      "expected_stdout": "60.00\n"
    },
    {
      "id": "on_lines",
      "stdin": "1\n2\n4\n",
      "expected_stdout": "2.33\n"
    }
  ]
}
