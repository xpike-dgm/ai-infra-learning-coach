{
  "format": "code_test_suite/1",
  "suite": "codetest.python.files_paths_basic.demonstrate_capability.g08@v1",
  "item": "item.python.files_paths_basic.demonstrate_capability.g08@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, tempfile, cozum\nfrom pathlib import Path\nicerik = sys.argv[1].replace(\"|\", chr(10))\nwith tempfile.TemporaryDirectory() as d:\n    yol = Path(d) / \"puanlar.csv\"\n    yol.write_bytes(icerik.encode(\"utf-8\"))\n    print(sorted(cozum.puanlari_oku(yol).items()))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two",
      "args": [
        "Ali,70|Ece,95|"
      ],
      "expected_stdout": "[('Ali', 70), ('Ece', 95)]\n"
    },
    {
      "id": "blank_lines",
      "args": [
        "|Can,5||"
      ],
      "expected_stdout": "[('Can', 5)]\n"
    },
    {
      "id": "empty",
      "args": [
        ""
      ],
      "expected_stdout": "[]\n"
    }
  ]
}
