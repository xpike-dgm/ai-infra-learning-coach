{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.g03@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.g03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nd = {}\nfor x in sys.argv[1:]:\n    k, v = x.split(\"=\")\n    d[k] = int(v)\nyeni = cozum.iki_kat(d)\nprint(sorted(yeni.items()), sorted(d.items()))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two",
      "args": [
        "a=2",
        "b=5"
      ],
      "expected_stdout": "[('a', 4), ('b', 10)] [('a', 2), ('b', 5)]\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "[] []\n"
    }
  ]
}
