{
  "format": "code_test_suite/1",
  "suite": "codetest.python.files_paths_basic.demonstrate_capability.f05@v1",
  "item": "item.python.files_paths_basic.demonstrate_capability.f05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, tempfile, cozum\nfrom pathlib import Path\nwith tempfile.TemporaryDirectory() as d:\n    kaynak = Path(d) / \"sayilar.txt\"\n    hedef = Path(d) / \"sonuc.txt\"\n    if sys.argv[1] != \"<yok>\":\n        kaynak.write_bytes(sys.argv[1].replace(\"|\", chr(10)).encode(\"utf-8\"))\n    cozum.toplami_yaz(kaynak, hedef)\n    print(ascii(hedef.read_text(encoding=\"utf-8\")))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "numbers",
      "args": [
        "4|10|-3|"
      ],
      "expected_stdout": "'toplam=11\\n'\n"
    },
    {
      "id": "blank_lines",
      "args": [
        "5||7||"
      ],
      "expected_stdout": "'toplam=12\\n'\n"
    },
    {
      "id": "missing_source",
      "args": [
        "<yok>"
      ],
      "expected_stdout": "'toplam=yok\\n'\n"
    },
    {
      "id": "empty_source",
      "args": [
        ""
      ],
      "expected_stdout": "'toplam=0\\n'\n"
    }
  ]
}
