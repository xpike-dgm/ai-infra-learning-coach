{
  "format": "code_test_suite/1",
  "suite": "codetest.python.string_text_operations.demonstrate_capability.g03@v1",
  "item": "item.python.string_text_operations.demonstrate_capability.g03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(\"[\" + cozum.ilk_kelime(sys.argv[1]) + \"]\")"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "leading_spaces",
      "args": [
        "  merhaba dünya"
      ],
      "expected_stdout": "[merhaba]\n"
    },
    {
      "id": "one_word",
      "args": [
        "tek"
      ],
      "expected_stdout": "[tek]\n"
    },
    {
      "id": "empty",
      "args": [
        "   "
      ],
      "expected_stdout": "[]\n"
    }
  ]
}
