<?xml version="1.0" encoding="utf-8"?>
<!-- Colours live in the Compose theme built from the WFPX-v0 measured tokens (10C).
     This resource theme exists only so the activity has a launch theme. 17A (VPLX-v0): its window background is
     the measured light `surface` token, so the first frame is not a dark window under dark text; values-night carries
     the dark `surface`. A validator compares both hex values with DesignTokens. -->
<resources>
    <style name="Theme.Coach" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/coach_surface</item>
    </style>
    <color name="coach_surface">#FFFFFF</color>
</resources>
