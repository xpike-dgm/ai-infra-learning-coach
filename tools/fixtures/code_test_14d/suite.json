{
  "format": "code_test_suite/1",
  "suite": "codetest.py.sum_two@v1",
  "item": "item.py.sum_two@v1",
  "build": {"command": ["{python}", "-m", "py_compile", "main.py"]},
  "run": {"command": ["{python}", "main.py"]},
  "timeout_seconds": 2,
  "compare": "trim_trailing_whitespace",
  "tests": [
