{
  "format": "code_test_suite/1",
  "suite": "codetest.python.modules_imports_basic.import_and_use_module_member.f02@v1",
  "item": "item.python.modules_imports_basic.import_and_use_module_member.f02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.ortanca([int(x) for x in sys.argv[1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "odd",
      "args": [
        "9",
        "1",
        "2"
      ],
      "expected_stdout": "2\n"
    },
    {
      "id": "even",
      "args": [
        "4",
        "1",
        "3",
        "2"
      ],
      "expected_stdout": "2.5\n"
    },
    {
      "id": "single",
      "args": [
        "7"
      ],
      "expected_stdout": "7\n"
    }
  ]
}
