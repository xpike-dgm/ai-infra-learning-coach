{
  "format": "code_test_suite/1",
  "suite": "codetest.python.while_termination.debug_infinite_loop.f04@v1",
  "item": "item.python.while_termination.debug_infinite_loop.f04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "four_digits",
      "stdin": "4721\n",
      "expected_stdout": "14\n"
    },
    {
      "id": "one_digit",
      "stdin": "7\n",
      "expected_stdout": "7\n"
    },
    {
      "id": "with_zeros",
      "stdin": "1005\n",
      "expected_stdout": "6\n"
    }
  ]
}
