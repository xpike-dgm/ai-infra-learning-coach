{
  "format": "code_test_suite/1",
  "suite": "codetest.python.set_operations.demonstrate_capability.f02@v1",
  "item": "item.python.set_operations.demonstrate_capability.f02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nayrac = sys.argv.index(\"|\")\na = [int(x) for x in sys.argv[1:ayrac]]\nb = [int(x) for x in sys.argv[ayrac + 1:]]\nprint(cozum.ortak(a, b))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two_common",
      "args": [
        "1",
        "2",
        "2",
        "5",
        "|",
        "2",
        "5",
        "7"
      ],
      "expected_stdout": "[2, 5]\n"
    },
    {
      "id": "none_common",
      "args": [
        "1",
        "|",
        "2"
      ],
      "expected_stdout": "[]\n"
    },
    {
      "id": "unsorted_input",
      "args": [
        "9",
        "3",
        "6",
        "|",
        "6",
        "9",
        "1"
      ],
      "expected_stdout": "[6, 9]\n"
    }
  ]
}
