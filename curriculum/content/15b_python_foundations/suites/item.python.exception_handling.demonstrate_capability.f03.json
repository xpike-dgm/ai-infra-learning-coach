{
  "format": "code_test_suite/1",
  "suite": "codetest.python.exception_handling.demonstrate_capability.f03@v1",
  "item": "item.python.exception_handling.demonstrate_capability.f03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\ndegerler = [None if x == \"<none>\" else x for x in sys.argv[1:]]\ntry:\n    print(cozum.gecerli_toplam(degerler))\nexcept Exception as e:\n    print(\"yukarıya geldi:\", type(e).__name__)"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "one_bad",
      "args": [
        "4",
        "x",
        "6"
      ],
      "expected_stdout": "(10, 1)\n"
    },
    {
      "id": "all_good",
      "args": [
        "1",
        "2",
        "3"
      ],
      "expected_stdout": "(6, 0)\n"
    },
    {
      "id": "all_bad",
      "args": [
        "a",
        "b"
      ],
      "expected_stdout": "(0, 2)\n"
    },
    {
      "id": "negative_and_decimal",
      "args": [
        "-5",
        "3.5",
        "10"
      ],
      "expected_stdout": "(5, 1)\n"
    },
    {
      "id": "non_text_propagates",
      "args": [
        "4",
        "<none>"
      ],
      "expected_stdout": "yukarıya geldi: TypeError\n"
    }
  ]
}
