{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.f03@v1",
  "item": "item.python.path_handling.read_write_small_text_file.f03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.birlestir(sys.argv[1], sys.argv[2]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "plain",
      "args": [
        "veri",
        "ocak.csv"
      ],
      "expected_stdout": "veri/ocak.csv\n"
    },
    {
      "id": "trailing_slash",
      "args": [
        "veri/",
        "ocak.csv"
      ],
      "expected_stdout": "veri/ocak.csv\n"
    },
    {
      "id": "nested",
      "args": [
        "proje/kaynak",
        "ana.py"
      ],
      "expected_stdout": "proje/kaynak/ana.py\n"
    }
  ]
}
