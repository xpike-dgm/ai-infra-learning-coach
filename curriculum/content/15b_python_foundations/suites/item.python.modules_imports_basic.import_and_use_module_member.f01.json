{
  "format": "code_test_suite/1",
  "suite": "codetest.python.modules_imports_basic.import_and_use_module_member.f01@v1",
  "item": "item.python.modules_imports_basic.import_and_use_module_member.f01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.alan(float(sys.argv[1])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "unit",
      "args": [
        "1"
      ],
      "expected_stdout": "3.14\n"
    },
    {
      "id": "two",
      "args": [
        "2"
      ],
      "expected_stdout": "12.57\n"
    },
    {
      "id": "half",
      "args": [
        "0.5"
      ],
      "expected_stdout": "0.79\n"
    }
  ]
}
