{
  "format": "code_test_suite/1",
  "suite": "codetest.python.while_termination.debug_infinite_loop.f03@v1",
  "item": "item.python.while_termination.debug_infinite_loop.f03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "even_bound",
      "stdin": "6\n",
      "expected_stdout": "0\n2\n4\n"
    },
    {
      "id": "odd_bound",
      "stdin": "7\n",
      "expected_stdout": "0\n2\n4\n6\n"
    },
    {
      "id": "one",
      "stdin": "1\n",
      "expected_stdout": "0\n"
    }
  ]
}
