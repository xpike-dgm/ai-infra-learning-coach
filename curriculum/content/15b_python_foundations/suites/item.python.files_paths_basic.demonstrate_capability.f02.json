{
  "format": "code_test_suite/1",
  "suite": "codetest.python.files_paths_basic.demonstrate_capability.f02@v1",
  "item": "item.python.files_paths_basic.demonstrate_capability.f02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, tempfile, cozum\nfrom pathlib import Path\nwith tempfile.TemporaryDirectory() as d:\n    yol = Path(d) / \"cikti.txt\"\n    yol.write_bytes(\"ESKİ İÇERİK\".encode(\"utf-8\") + bytes([10]))\n    cozum.satirlari_yaz(yol, sys.argv[1:])\n    print(ascii(yol.read_text(encoding=\"utf-8\")))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two_lines",
      "args": [
        "bir",
        "iki"
      ],
      "expected_stdout": "'bir\\niki\\n'\n"
    },
    {
      "id": "turkish",
      "args": [
        "ğüşıöç"
      ],
      "expected_stdout": "'\\u011f\\xfc\\u015f\\u0131\\xf6\\xe7\\n'\n"
    },
    {
      "id": "empty_list",
      "args": [],
      "expected_stdout": "''\n"
    }
  ]
}
