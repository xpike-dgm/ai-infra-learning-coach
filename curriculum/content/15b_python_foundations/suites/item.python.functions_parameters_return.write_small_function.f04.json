{
  "format": "code_test_suite/1",
  "suite": "codetest.python.functions_parameters_return.write_small_function.f04@v1",
  "item": "item.python.functions_parameters_return.write_small_function.f04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.selam(*sys.argv[1:]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "default_title",
      "args": [
        "Ayşe"
      ],
      "expected_stdout": "Sayın Ayşe\n"
    },
    {
      "id": "given_title",
      "args": [
        "Can",
        "Dr."
      ],
      "expected_stdout": "Dr. Can\n"
    },
    {
      "id": "another_title",
      "args": [
        "Ece",
        "Prof."
      ],
      "expected_stdout": "Prof. Ece\n"
    }
  ]
}
