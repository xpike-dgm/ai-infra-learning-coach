{
  "format": "code_test_suite/1",
  "suite": "codetest.python.for_iteration.iterate_sequence.f05@v1",
  "item": "item.python.for_iteration.iterate_sequence.f05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "mixed",
      "stdin": "4\n3\n9\n-2\n7\n",
      "expected_stdout": "9\n"
    },
    {
      "id": "all_negative",
      "stdin": "3\n-8\n-3\n-5\n",
      "expected_stdout": "-3\n"
    },
    {
      "id": "single",
      "stdin": "1\n42\n",
      "expected_stdout": "42\n"
    },
    {
      "id": "first_is_max",
      "stdin": "3\n10\n4\n6\n",
      "expected_stdout": "10\n"
    }
  ]
}
