{
  "format": "code_test_suite/1",
  "suite": "codetest.python.exception_handling.demonstrate_capability.f04@v1",
  "item": "item.python.exception_handling.demonstrate_capability.f04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\ntry:\n    print(cozum.siparis_tutari(int(sys.argv[1]), int(sys.argv[2])))\nexcept Exception as e:\n    print(type(e).__name__ + \":\", e)"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "valid",
      "args": [
        "3",
        "20"
      ],
      "expected_stdout": "60\n"
    },
    {
      "id": "zero",
      "args": [
        "0",
        "20"
      ],
      "expected_stdout": "ValueError: adet pozitif olmalı\n"
    },
    {
      "id": "negative",
      "args": [
        "-2",
        "5"
      ],
      "expected_stdout": "ValueError: adet pozitif olmalı\n"
    }
  ]
}
