{
  "format": "code_test_suite/1",
  "suite": "codetest.python.functions_parameters_return.write_small_function.f03@v1",
  "item": "item.python.functions_parameters_return.write_small_function.f03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.indirimli(int(sys.argv[1]), int(sys.argv[2])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "ten_percent",
      "args": [
        "200",
        "10"
      ],
      "expected_stdout": "180\n"
    },
    {
      "id": "no_discount",
      "args": [
        "99",
        "0"
      ],
      "expected_stdout": "99\n"
    },
    {
      "id": "half",
      "args": [
        "50",
        "50"
      ],
      "expected_stdout": "25\n"
    },
    {
      "id": "rounding_down",
      "args": [
        "99",
        "10"
      ],
      "expected_stdout": "90\n"
    }
  ]
}
