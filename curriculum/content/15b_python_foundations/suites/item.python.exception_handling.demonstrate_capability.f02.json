{
  "format": "code_test_suite/1",
  "suite": "codetest.python.exception_handling.demonstrate_capability.f02@v1",
  "item": "item.python.exception_handling.demonstrate_capability.f02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nstok = [3, 5] if sys.argv[1] == \"<liste>\" else {\"kalem\": 12, \"defter\": 0}\ntry:\n    print(cozum.stok_miktari(stok, sys.argv[2]))\nexcept Exception as e:\n    print(\"yukarıya geldi\")"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "present",
      "args": [
        "sozluk",
        "kalem"
      ],
      "expected_stdout": "12\n"
    },
    {
      "id": "present_zero",
      "args": [
        "sozluk",
        "defter"
      ],
      "expected_stdout": "0\n"
    },
    {
      "id": "missing",
      "args": [
        "sozluk",
        "silgi"
      ],
      "expected_stdout": "None\n"
    },
    {
      "id": "wrong_type_propagates",
      "args": [
        "<liste>",
        "kalem"
      ],
      "expected_stdout": "yukarıya geldi\n"
    }
  ]
}
