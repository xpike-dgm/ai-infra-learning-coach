{
  "format": "code_test_suite/1",
  "suite": "codetest.python.string_text_operations.demonstrate_capability.f04@v1",
  "item": "item.python.string_text_operations.demonstrate_capability.f04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.ters_kelimeler(sys.argv[1]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "four_words",
      "args": [
        "bugün hava çok güzel"
      ],
      "expected_stdout": "güzel çok hava bugün\n"
    },
    {
      "id": "one_word",
      "args": [
        "merhaba"
      ],
      "expected_stdout": "merhaba\n"
    },
    {
      "id": "extra_spaces",
      "args": [
        " bir  iki üç "
      ],
      "expected_stdout": "üç iki bir\n"
    }
  ]
}
