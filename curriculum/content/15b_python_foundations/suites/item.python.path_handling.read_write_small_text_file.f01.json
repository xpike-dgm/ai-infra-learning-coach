{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.f01@v1",
  "item": "item.python.path_handling.read_write_small_text_file.f01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(repr(cozum.uzanti(sys.argv[1])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "simple",
      "args": [
        "belgeler/sunum.pptx"
      ],
      "expected_stdout": "'.pptx'\n"
    },
    {
      "id": "two_dots",
      "args": [
        "yedek/veri.tar.gz"
      ],
      "expected_stdout": "'.gz'\n"
    },
    {
      "id": "no_extension",
      "args": [
        "Makefile"
      ],
      "expected_stdout": "''\n"
    }
  ]
}
