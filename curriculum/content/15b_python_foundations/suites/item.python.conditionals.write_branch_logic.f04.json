{
  "format": "code_test_suite/1",
  "suite": "codetest.python.conditionals.write_branch_logic.f04@v1",
  "item": "item.python.conditionals.write_branch_logic.f04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "ordinary_leap",
      "stdin": "2024\n",
      "expected_stdout": "artık\n"
    },
    {
      "id": "century_not_leap",
      "stdin": "1900\n",
      "expected_stdout": "değil\n"
    },
    {
      "id": "four_hundred",
      "stdin": "2000\n",
      "expected_stdout": "artık\n"
    },
    {
      "id": "ordinary",
      "stdin": "2023\n",
      "expected_stdout": "değil\n"
    }
  ]
}
