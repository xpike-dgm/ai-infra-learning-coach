{
  "format": "code_test_suite/1",
  "suite": "codetest.python.input_output_basic.build_small_io_flow.f02@v1",
  "item": "item.python.input_output_basic.build_small_io_flow.f02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "small",
      "stdin": "2\n3\n",
      "expected_stdout": "6 5\n"
    },
    {
      "id": "negative",
      "stdin": "10\n-4\n",
      "expected_stdout": "-40 6\n"
    },
    {
      "id": "zeros",
      "stdin": "0\n0\n",
      "expected_stdout": "0 0\n"
    }
  ]
}
