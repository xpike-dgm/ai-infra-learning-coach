{
  "format": "code_test_suite/1",
  "suite": "codetest.python.exception_handling.demonstrate_capability.f01@v1",
  "item": "item.python.exception_handling.demonstrate_capability.f01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\na = sys.argv[1] if sys.argv[1].isalpha() else int(sys.argv[1])\ntry:\n    print(cozum.guvenli_bol(a, int(sys.argv[2])))\nexcept Exception as e:\n    print(\"yukarıya geldi:\", type(e).__name__)"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "normal",
      "args": [
        "9",
        "2"
      ],
      "expected_stdout": "4.5\n"
    },
    {
      "id": "zero",
      "args": [
        "9",
        "0"
      ],
      "expected_stdout": "None\n"
    },
    {
      "id": "other_error_propagates",
      "args": [
        "abc",
        "2"
      ],
      "expected_stdout": "yukarıya geldi: TypeError\n"
    }
  ]
}
