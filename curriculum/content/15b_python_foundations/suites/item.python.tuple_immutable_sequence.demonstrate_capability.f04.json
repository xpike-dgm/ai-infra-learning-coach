{
  "format": "code_test_suite/1",
  "suite": "codetest.python.tuple_immutable_sequence.demonstrate_capability.f04@v1",
  "item": "item.python.tuple_immutable_sequence.demonstrate_capability.f04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\na = sys.argv[1:]\nkayitlar = [(a[i], int(a[i + 1])) for i in range(0, len(a), 2)]\nprint(cozum.birinci(kayitlar))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "tie_keeps_first",
      "args": [
        "Ayşe",
        "87",
        "Can",
        "92",
        "Ece",
        "92"
      ],
      "expected_stdout": "Can\n"
    },
    {
      "id": "single",
      "args": [
        "Deniz",
        "50"
      ],
      "expected_stdout": "Deniz\n"
    },
    {
      "id": "first_is_best",
      "args": [
        "Ali",
        "99",
        "Su",
        "10"
      ],
      "expected_stdout": "Ali\n"
    }
  ]
}
