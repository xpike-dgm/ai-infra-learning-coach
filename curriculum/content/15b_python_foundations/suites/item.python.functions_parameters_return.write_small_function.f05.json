{
  "format": "code_test_suite/1",
  "suite": "codetest.python.functions_parameters_return.write_small_function.f05@v1",
  "item": "item.python.functions_parameters_return.write_small_function.f05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\na = [int(x) for x in sys.argv[1:]]\nasil = cozum.alan\ncagrilar = []\ndef izle(en, boy):\n    cagrilar.append((en, boy))\n    return asil(en, boy)\ncozum.alan = izle\nprint(asil(a[0], a[1]), cozum.boya_maliyeti(a[0], a[1], a[2]), \"alan kullanıldı\" if cagrilar else \"alan kullanılmadı\")"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "small_wall",
      "args": [
        "3",
        "4",
        "5"
      ],
      "expected_stdout": "12 60 alan kullanıldı\n"
    },
    {
      "id": "square",
      "args": [
        "2",
        "2",
        "10"
      ],
      "expected_stdout": "4 40 alan kullanıldı\n"
    },
    {
      "id": "zero_price",
      "args": [
        "7",
        "3",
        "0"
      ],
      "expected_stdout": "21 0 alan kullanıldı\n"
    }
  ]
}
