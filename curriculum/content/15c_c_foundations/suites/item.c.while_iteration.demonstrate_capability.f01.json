{
  "format": "code_test_suite/1",
  "suite": "codetest.c.while_iteration.demonstrate_capability.f01@v1",
  "item": "item.c.while_iteration.demonstrate_capability.f01@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "four_digits",
      "stdin": "4096\n",
      "expected_stdout": "4\n"
    },
    {
      "id": "one_digit",
      "stdin": "7\n",
      "expected_stdout": "1\n"
    },
    {
      "id": "zero",
      "stdin": "0\n",
      "expected_stdout": "1\n"
    },
    {
      "id": "ten",
      "stdin": "10\n",
      "expected_stdout": "2\n"
    }
  ]
}
