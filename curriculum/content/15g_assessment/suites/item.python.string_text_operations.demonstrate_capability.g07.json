{
  "format": "code_test_suite/1",
  "suite": "codetest.python.string_text_operations.demonstrate_capability.g07@v1",
  "item": "item.python.string_text_operations.demonstrate_capability.g07@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(\"[\" + cozum.sansurle(sys.argv[1], sys.argv[2]) + \"]\")"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "example",
      "args": [
        "kötü gün, kötü hava",
        "kötü"
      ],
      "expected_stdout": "[**** gün, **** hava]\n"
    },
    {
      "id": "absent",
      "args": [
        "güzel gün",
        "kötü"
      ],
      "expected_stdout": "[güzel gün]\n"
    },
    {
      "id": "inside_word",
      "args": [
        "kalemlik kalem",
        "kalem"
      ],
      "expected_stdout": "[*****lik *****]\n"
    }
  ]
}
