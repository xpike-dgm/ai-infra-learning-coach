{
  "format": "code_test_suite/1",
  "suite": "codetest.python.tuple_immutable_sequence.demonstrate_capability.g05@v1",
  "item": "item.python.tuple_immutable_sequence.demonstrate_capability.g05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\na = sys.argv[1:]\nkayitlar = [(a[i], int(a[i + 1])) for i in range(0, len(a), 2)]\nprint(cozum.toplam_puan(kayitlar))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two",
      "args": [
        "Ayşe",
        "80",
        "Can",
        "75"
      ],
      "expected_stdout": "155\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "0\n"
    },
    {
      "id": "three",
      "args": [
        "A",
        "10",
        "B",
        "0",
        "C",
        "5"
      ],
      "expected_stdout": "15\n"
    }
  ]
}
