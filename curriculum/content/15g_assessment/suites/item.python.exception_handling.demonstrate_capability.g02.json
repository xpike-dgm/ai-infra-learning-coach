{
  "format": "code_test_suite/1",
  "suite": "codetest.python.exception_handling.demonstrate_capability.g02@v1",
  "item": "item.python.exception_handling.demonstrate_capability.g02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\ni = sys.argv[1][1:-1] if sys.argv[1].startswith(\"<\") else int(sys.argv[1])\ntry:\n    print(cozum.eleman([int(x) for x in sys.argv[2:]], i))\nexcept Exception as e:\n    print(\"yukarıya geldi\")"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "inside",
      "args": [
        "1",
        "4",
        "8",
        "15"
      ],
      "expected_stdout": "8\n"
    },
    {
      "id": "too_far",
      "args": [
        "3",
        "4",
        "8",
        "15"
      ],
      "expected_stdout": "yok\n"
    },
    {
      "id": "last",
      "args": [
        "-1",
        "4",
        "8",
        "15"
      ],
      "expected_stdout": "15\n"
    },
    {
      "id": "too_far_back",
      "args": [
        "-5",
        "4",
        "8",
        "15"
      ],
      "expected_stdout": "yok\n"
    },
    {
      "id": "wrong_type_propagates",
      "args": [
        "<1>",
        "4",
        "8",
        "15"
      ],
      "expected_stdout": "yukarıya geldi\n"
    }
  ]
}
