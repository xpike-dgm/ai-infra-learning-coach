{
  "format": "code_test_suite/1",
  "suite": "codetest.python.conditionals.write_branch_logic.g04@v1",
  "item": "item.python.conditionals.write_branch_logic.g04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "middle_last",
      "stdin": "7\n2\n5\n",
      "expected_stdout": "5\n"
    },
    {
      "id": "middle_first",
      "stdin": "4\n9\n1\n",
      "expected_stdout": "4\n"
    },
    {
      "id": "middle_second",
      "stdin": "1\n3\n8\n",
      "expected_stdout": "3\n"
    },
    {
      "id": "two_equal",
      "stdin": "6\n6\n2\n",
      "expected_stdout": "6\n"
    },
    {
      "id": "all_equal",
      "stdin": "3\n3\n3\n",
      "expected_stdout": "3\n"
    },
    {
      "id": "descending",
      "stdin": "9\n5\n2\n",
      "expected_stdout": "5\n"
    }
  ]
}
