{
  "format": "code_test_suite/1",
  "suite": "codetest.python.modules_imports_basic.import_and_use_module_member.g01@v1",
  "item": "item.python.modules_imports_basic.import_and_use_module_member.g01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.hipotenus(int(sys.argv[1]), int(sys.argv[2])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three_four",
      "args": [
        "3",
        "4"
      ],
      "expected_stdout": "5.0\n"
    },
    {
      "id": "unit",
      "args": [
        "1",
        "1"
      ],
      "expected_stdout": "1.41\n"
    },
    {
      "id": "five_twelve",
      "args": [
        "5",
        "12"
      ],
      "expected_stdout": "13.0\n"
    }
  ]
