{
  "format": "code_test_suite/1",
  "suite": "codetest.python.set_operations.demonstrate_capability.g04@v1",
  "item": "item.python.set_operations.demonstrate_capability.g04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nayrac = sys.argv.index(\"|\")\nprint(cozum.simetrik_fark([int(x) for x in sys.argv[1:ayrac]], [int(x) for x in sys.argv[ayrac + 1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "mixed",
      "args": [
        "1",
        "2",
        "3",
        "|",
        "3",
        "4"
      ],
      "expected_stdout": "[1, 2, 4]\n"
    },
    {
      "id": "same",
      "args": [
        "5",
        "6",
        "|",
        "6",
        "5"
      ],
      "expected_stdout": "[]\n"
    },
    {
      "id": "disjoint",
      "args": [
        "2",
        "|",
        "1"
      ],
      "expected_stdout": "[1, 2]\n"
    }
  ]
}
