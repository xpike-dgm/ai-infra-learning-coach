{
  "format": "code_test_suite/1",
  "suite": "codetest.python.input_output_basic.build_small_io_flow.g10@v1",
  "item": "item.python.input_output_basic.build_small_io_flow.g10@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three_times",
      "stdin": "ha\n3\n",
      "expected_stdout": "Tekrar: hahaha\n"
    },
    {
      "id": "once",
      "stdin": "abc\n1\n",
      "expected_stdout": "Tekrar: abc\n"
    },
    {
      "id": "zero_times",
      "stdin": "x\n0\n",
      "expected_stdout": "Tekrar: \n"
    }
  ]
}
