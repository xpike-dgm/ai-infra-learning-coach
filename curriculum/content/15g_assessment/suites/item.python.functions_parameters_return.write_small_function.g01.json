{
  "format": "code_test_suite/1",
  "suite": "codetest.python.functions_parameters_return.write_small_function.g01@v1",
  "item": "item.python.functions_parameters_return.write_small_function.g01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.bol(int(sys.argv[1]), int(sys.argv[2])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "half",
      "args": [
        "7",
        "2"
      ],
      "expected_stdout": "3.5\n"
    },
    {
      "id": "zero_divisor",
      "args": [
        "5",
        "0"
      ],
      "expected_stdout": "None\n"
    },
    {
      "id": "zero_numerator",
      "args": [
        "0",
        "3"
      ],
      "expected_stdout": "0.0\n"
    }
  ]
}
