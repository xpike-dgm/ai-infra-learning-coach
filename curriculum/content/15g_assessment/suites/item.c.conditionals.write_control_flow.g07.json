{
  "format": "code_test_suite/1",
  "suite": "codetest.c.conditionals.write_control_flow.g07@v1",
  "item": "item.c.conditionals.write_control_flow.g07@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "big",
      "stdin": "15\n",
      "expected_stdout": "buyuk\ndikkat\n"
    },
    {
      "id": "small",
      "stdin": "3\n",
      "expected_stdout": ""
    },
    {
      "id": "boundary",
      "stdin": "10\n",
      "expected_stdout": ""
    }
  ]
}
