{
  "format": "code_test_suite/1",
  "suite": "codetest.python.set_operations.demonstrate_capability.g05@v1",
  "item": "item.python.set_operations.demonstrate_capability.g05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nayrac = sys.argv.index(\"|\")\nprint(cozum.hepsi_var_mi([int(x) for x in sys.argv[1:ayrac]], [int(x) for x in sys.argv[ayrac + 1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "all_there",
      "args": [
        "1",
        "2",
        "|",
        "2",
        "3",
        "1"
      ],
      "expected_stdout": "True\n"
    },
    {
      "id": "one_missing",
      "args": [
        "1",
        "4",
        "|",
        "1",
        "2"
      ],
      "expected_stdout": "False\n"
    },
    {
      "id": "nothing_needed",
      "args": [
        "|",
        "7"
      ],
      "expected_stdout": "True\n"
    },
    {
      "id": "repeats",
      "args": [
        "2",
        "2",
        "|",
        "2"
      ],
      "expected_stdout": "True\n"
    }
  ]
}
