{
  "format": "code_test_suite/1",
  "suite": "codetest.c.for_iteration.demonstrate_capability.g05@v1",
  "item": "item.c.for_iteration.demonstrate_capability.g05@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "mixed",
      "stdin": "4\n3 9 -2 7\n",
      "expected_stdout": "9\n"
    },
    {
      "id": "all_negative",
      "stdin": "3\n-8 -3 -5\n",
      "expected_stdout": "-3\n"
    },
    {
      "id": "single",
      "stdin": "1\n42\n",
      "expected_stdout": "42\n"
    }
  ]
}
