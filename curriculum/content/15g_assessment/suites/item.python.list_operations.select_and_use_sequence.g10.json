{
  "format": "code_test_suite/1",
  "suite": "codetest.python.list_operations.select_and_use_sequence.g10@v1",
  "item": "item.python.list_operations.select_and_use_sequence.g10@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nliste = [int(x) for x in sys.argv[3:]]\nsonuc = cozum.takasli(liste, int(sys.argv[1]), int(sys.argv[2]))\nprint(sonuc, liste)"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "ends",
      "args": [
        "0",
        "2",
        "5",
        "6",
        "7"
      ],
      "expected_stdout": "[7, 6, 5] [5, 6, 7]\n"
    },
    {
      "id": "same_place",
      "args": [
        "1",
        "1",
        "5",
        "6",
        "7"
      ],
      "expected_stdout": "[5, 6, 7] [5, 6, 7]\n"
    },
    {
      "id": "negative",
      "args": [
        "0",
        "-1",
        "1",
        "2",
        "3",
        "4"
      ],
      "expected_stdout": "[4, 2, 3, 1] [1, 2, 3, 4]\n"
    }
  ]
}
