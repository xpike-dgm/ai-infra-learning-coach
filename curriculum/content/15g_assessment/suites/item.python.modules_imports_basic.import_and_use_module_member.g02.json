{
  "format": "code_test_suite/1",
  "suite": "codetest.python.modules_imports_basic.import_and_use_module_member.g02@v1",
  "item": "item.python.modules_imports_basic.import_and_use_module_member.g02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.asagi_yuvarla(float(sys.argv[1])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "positive",
      "args": [
        "2.7"
      ],
      "expected_stdout": "2\n"
    },
    {
      "id": "negative",
      "args": [
        "-2.5"
      ],
      "expected_stdout": "-3\n"
    },
    {
      "id": "whole",
      "args": [
        "4.0"
      ],
      "expected_stdout": "4\n"
    }
  ]
}
