{
  "format": "code_test_suite/1",
  "suite": "codetest.python.string_text_operations.demonstrate_capability.g11@v1",
  "item": "item.python.string_text_operations.demonstrate_capability.g11@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.tarih_cevir(sys.argv[1]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "today",
      "args": [
        "2026-10-04"
      ],
      "expected_stdout": "04.10.2026\n"
    },
    {
      "id": "new_year",
      "args": [
        "2000-01-01"
      ],
      "expected_stdout": "01.01.2000\n"
    },
    {
      "id": "end_of_year",
      "args": [
        "1999-12-31"
      ],
      "expected_stdout": "31.12.1999\n"
    }
  ]
}
