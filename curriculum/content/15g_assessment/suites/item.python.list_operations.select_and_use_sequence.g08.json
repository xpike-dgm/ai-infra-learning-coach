{
  "format": "code_test_suite/1",
  "suite": "codetest.python.list_operations.select_and_use_sequence.g08@v1",
  "item": "item.python.list_operations.select_and_use_sequence.g08@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.ikili_ortalamalar([int(x) for x in sys.argv[1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three",
      "args": [
        "2",
        "4",
        "6"
      ],
      "expected_stdout": "[3.0, 5.0]\n"
    },
    {
      "id": "half",
      "args": [
        "1",
        "2"
      ],
      "expected_stdout": "[1.5]\n"
    },
    {
      "id": "single",
      "args": [
        "7"
      ],
      "expected_stdout": "[]\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "[]\n"
    }
  ]
}
