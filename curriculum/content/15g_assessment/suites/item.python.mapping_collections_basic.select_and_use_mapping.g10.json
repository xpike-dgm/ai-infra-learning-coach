{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.g10@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.g10@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.harfleri_ayni_mi(sys.argv[1], sys.argv[2]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "anagram",
      "args": [
        "kalem",
        "melak"
      ],
      "expected_stdout": "True\n"
    },
    {
      "id": "same_letters_different_counts",
      "args": [
        "aab",
        "abb"
      ],
      "expected_stdout": "False\n"
    },
    {
      "id": "different_length",
      "args": [
        "ev",
        "eve"
      ],
      "expected_stdout": "False\n"
    },
    {
      "id": "identical",
      "args": [
        "su",
        "su"
      ],
      "expected_stdout": "True\n"
    }
  ]
}
