{
  "format": "code_test_suite/1",
  "suite": "codetest.python.list_operations.select_and_use_sequence.g01@v1",
  "item": "item.python.list_operations.select_and_use_sequence.g01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.ilk_iki([int(x) for x in sys.argv[1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "three",
      "args": [
        "5",
        "6",
        "7"
      ],
      "expected_stdout": "[5, 6]\n"
    },
    {
      "id": "one",
      "args": [
        "9"
      ],
      "expected_stdout": "[9]\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "[]\n"
    },
    {
      "id": "two",
      "args": [
        "1",
        "2"
      ],
      "expected_stdout": "[1, 2]\n"
    }
  ]
}
