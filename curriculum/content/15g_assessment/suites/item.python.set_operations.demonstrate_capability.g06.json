{
  "format": "code_test_suite/1",
  "suite": "codetest.python.set_operations.demonstrate_capability.g06@v1",
  "item": "item.python.set_operations.demonstrate_capability.g06@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.eksik_sayilar([int(x) for x in sys.argv[2:]], int(sys.argv[1])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two_missing",
      "args": [
        "5",
        "2",
        "5",
        "1"
      ],
      "expected_stdout": "[3, 4]\n"
    },
    {
      "id": "none_missing",
      "args": [
        "3",
        "3",
        "1",
        "2"
      ],
      "expected_stdout": "[]\n"
    },
    {
      "id": "all_missing",
      "args": [
        "2"
      ],
      "expected_stdout": "[1, 2]\n"
    },
    {
      "id": "outside_values",
      "args": [
        "3",
        "9",
        "2"
      ],
      "expected_stdout": "[1, 3]\n"
    }
  ]
}
