{
  "format": "code_test_suite/1",
  "suite": "codetest.python.modules_imports_basic.import_and_use_module_member.g04@v1",
  "item": "item.python.modules_imports_basic.import_and_use_module_member.g04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.zar_at(int(sys.argv[1])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "seed_one",
      "args": [
        "1"
      ],
      "expected_stdout": "2\n"
    },
    {
      "id": "seed_forty_two",
      "args": [
        "42"
      ],
      "expected_stdout": "6\n"
    },
    {
      "id": "seed_seven",
      "args": [
        "7"
      ],
      "expected_stdout": "3\n"
    }
  ]
}
