{
  "format": "code_test_suite/1",
  "suite": "codetest.python.list_operations.select_and_use_sequence.g04@v1",
  "item": "item.python.list_operations.select_and_use_sequence.g04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.en_kucuk_konum([int(x) for x in sys.argv[1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "middle",
      "args": [
        "4",
        "1",
        "7"
      ],
      "expected_stdout": "1\n"
    },
    {
      "id": "tie_first",
      "args": [
        "3",
        "3"
      ],
      "expected_stdout": "0\n"
    },
    {
      "id": "single",
      "args": [
        "5"
      ],
      "expected_stdout": "0\n"
    },
    {
      "id": "tie_later",
      "args": [
        "6",
        "2",
        "9",
        "2"
      ],
      "expected_stdout": "1\n"
    },
    {
      "id": "last",
      "args": [
        "8",
        "7",
        "-1"
      ],
      "expected_stdout": "2\n"
    }
  ]
}
