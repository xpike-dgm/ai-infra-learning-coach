{
  "format": "code_test_suite/1",
  "suite": "codetest.python.set_operations.demonstrate_capability.g03@v1",
  "item": "item.python.set_operations.demonstrate_capability.g03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.acik_lambalar([int(x) for x in sys.argv[1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "example",
      "args": [
        "3",
        "1",
        "3",
        "2"
      ],
      "expected_stdout": "[1, 2]\n"
    },
    {
      "id": "none",
      "args": [],
      "expected_stdout": "[]\n"
    },
    {
      "id": "three_presses",
      "args": [
        "5",
        "5",
        "5"
      ],
      "expected_stdout": "[5]\n"
    },
    {
      "id": "all_off",
      "args": [
        "4",
        "2",
        "2",
        "4"
      ],
      "expected_stdout": "[]\n"
    }
  ]
}
