{
  "format": "code_test_suite/1",
  "suite": "codetest.c.for_iteration.demonstrate_capability.g06@v1",
  "item": "item.c.for_iteration.demonstrate_capability.g06@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two_ten",
      "stdin": "2 10\n",
      "expected_stdout": "1024\n"
    },
    {
      "id": "zero_power",
      "stdin": "7 0\n",
      "expected_stdout": "1\n"
    },
    {
      "id": "negative_base",
      "stdin": "-3 3\n",
      "expected_stdout": "-27\n"
    },
    {
      "id": "big",
      "stdin": "10 12\n",
      "expected_stdout": "1000000000000\n"
    }
  ]
}
