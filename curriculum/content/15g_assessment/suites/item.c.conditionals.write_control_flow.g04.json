{
  "format": "code_test_suite/1",
  "suite": "codetest.c.conditionals.write_control_flow.g04@v1",
  "item": "item.c.conditionals.write_control_flow.g04@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "negative",
      "stdin": "-7\n",
      "expected_stdout": "7\n"
    },
    {
      "id": "positive",
      "stdin": "12\n",
      "expected_stdout": "12\n"
    },
    {
      "id": "zero",
      "stdin": "0\n",
      "expected_stdout": "0\n"
    }
  ]
}
