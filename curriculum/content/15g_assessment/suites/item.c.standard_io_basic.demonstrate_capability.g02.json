{
  "format": "code_test_suite/1",
  "suite": "codetest.c.standard_io_basic.demonstrate_capability.g02@v1",
  "item": "item.c.standard_io_basic.demonstrate_capability.g02@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "whole",
      "stdin": "2.5 4\n",
      "expected_stdout": "10.00\n"
    },
    {
      "id": "cents",
      "stdin": "1.99 3\n",
      "expected_stdout": "5.97\n"
    },
    {
      "id": "zero",
      "stdin": "7.25 0\n",
      "expected_stdout": "0.00\n"
    }
  ]
}
