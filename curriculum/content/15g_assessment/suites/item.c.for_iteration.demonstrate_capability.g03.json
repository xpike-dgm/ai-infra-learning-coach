{
  "format": "code_test_suite/1",
  "suite": "codetest.c.for_iteration.demonstrate_capability.g03@v1",
  "item": "item.c.for_iteration.demonstrate_capability.g03@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "example",
      "stdin": "2 10\n",
      "expected_stdout": "2 5 8\n"
    },
    {
      "id": "lands_on_end",
      "stdin": "1 7\n",
      "expected_stdout": "1 4 7\n"
    },
    {
      "id": "single",
      "stdin": "5 5\n",
      "expected_stdout": "5\n"
    }
  ]
}
