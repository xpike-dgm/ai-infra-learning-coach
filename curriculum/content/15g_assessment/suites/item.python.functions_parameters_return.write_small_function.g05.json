{
  "format": "code_test_suite/1",
  "suite": "codetest.python.functions_parameters_return.write_small_function.g05@v1",
  "item": "item.python.functions_parameters_return.write_small_function.g05@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nsonuc = cozum.cift_mi(int(sys.argv[1]))\nprint(sonuc, type(sonuc).__name__)"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "even",
      "args": [
        "4"
      ],
      "expected_stdout": "True bool\n"
    },
    {
      "id": "odd",
      "args": [
        "7"
      ],
      "expected_stdout": "False bool\n"
    },
    {
      "id": "zero",
      "args": [
        "0"
      ],
      "expected_stdout": "True bool\n"
    },
    {
      "id": "negative",
      "args": [
        "-3"
      ],
      "expected_stdout": "False bool\n"
    }
  ]
}
