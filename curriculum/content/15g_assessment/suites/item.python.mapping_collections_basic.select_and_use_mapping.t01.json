{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.t01@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.t01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(sorted(cozum.kelime_say(sys.argv[1]).items()))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "example",
      "args": [
        "a b a"
      ],
      "expected_stdout": "[('a', 2), ('b', 1)]\n"
    },
    {
      "id": "words",
      "args": [
        "elma armut elma elma"
      ],
      "expected_stdout": "[('armut', 1), ('elma', 3)]\n"
    },
    {
      "id": "single",
      "args": [
        "tek"
      ],
      "expected_stdout": "[('tek', 1)]\n"
    }
  ]
}
