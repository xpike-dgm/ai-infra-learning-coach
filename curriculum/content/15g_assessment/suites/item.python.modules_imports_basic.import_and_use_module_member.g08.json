{
  "format": "code_test_suite/1",
  "suite": "codetest.python.modules_imports_basic.import_and_use_module_member.g08@v1",
  "item": "item.python.modules_imports_basic.import_and_use_module_member.g08@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.haftanin_gunu(sys.argv[1]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "sunday",
      "args": [
        "2026-10-04"
      ],
      "expected_stdout": "Pazar\n"
    },
    {
      "id": "saturday",
      "args": [
        "2000-01-01"
      ],
      "expected_stdout": "Cumartesi\n"
    },
    {
      "id": "leap_day",
      "args": [
        "2024-02-29"
      ],
      "expected_stdout": "Perşembe\n"
    }
  ]
}
