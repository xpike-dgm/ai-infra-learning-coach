{
  "format": "code_test_suite/1",
  "suite": "codetest.python.input_output_basic.build_small_io_flow.g06@v1",
  "item": "item.python.input_output_basic.build_small_io_flow.g06@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "nineteen",
      "stdin": "19\n",
      "expected_stdout": "Gelecek yıl 20!\n"
    },
    {
      "id": "zero",
      "stdin": "0\n",
      "expected_stdout": "Gelecek yıl 1!\n"
    },
    {
      "id": "large",
      "stdin": "99\n",
      "expected_stdout": "Gelecek yıl 100!\n"
    }
  ]
}
