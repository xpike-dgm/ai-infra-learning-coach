{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.g02@v1",
  "item": "item.python.path_handling.read_write_small_text_file.g02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(\"[\" + cozum.ust_klasor(sys.argv[1]) + \"]\")"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "nested",
      "args": [
        "veri/2026/olcum.csv"
      ],
      "expected_stdout": "[2026]\n"
    },
    {
      "id": "one_level",
      "args": [
        "resimler/a.png"
      ],
      "expected_stdout": "[resimler]\n"
    },
    {
      "id": "none",
      "args": [
        "tek.txt"
      ],
      "expected_stdout": "[]\n"
    }
  ]
}
