{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.g01@v1",
  "item": "item.python.path_handling.read_write_small_text_file.g01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(\"[\" + cozum.cift_uzanti(sys.argv[1]) + \"]\")"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "example",
      "args": [
        "yedek/gunluk.log.gz"
      ],
      "expected_stdout": "[.log.gz]\n"
    },
    {
      "id": "single",
      "args": [
        "notlar.txt"
      ],
      "expected_stdout": "[.txt]\n"
    },
    {
      "id": "none",
      "args": [
        "Makefile"
      ],
      "expected_stdout": "[]\n"
    },
    {
      "id": "three_dots",
      "args": [
        "a.b.c.d"
      ],
      "expected_stdout": "[.c.d]\n"
    },
    {
      "id": "dotted_folder",
      "args": [
        "surum.2/rapor.final.pdf"
      ],
      "expected_stdout": "[.final.pdf]\n"
    },
    {
      "id": "dotted_folder_single",
      "args": [
        "surum.2/rapor"
      ],
      "expected_stdout": "[]\n"
    }
  ]
}
