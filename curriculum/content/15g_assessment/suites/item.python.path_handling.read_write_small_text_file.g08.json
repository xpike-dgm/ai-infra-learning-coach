{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.g08@v1",
  "item": "item.python.path_handling.read_write_small_text_file.g08@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.rapor_yolu(int(sys.argv[1]), int(sys.argv[2])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "march",
      "args": [
        "2026",
        "3"
      ],
      "expected_stdout": "raporlar/2026/03.txt\n"
    },
    {
      "id": "december",
      "args": [
        "2025",
        "12"
      ],
      "expected_stdout": "raporlar/2025/12.txt\n"
    },
    {
      "id": "october",
      "args": [
        "2026",
        "10"
      ],
      "expected_stdout": "raporlar/2026/10.txt\n"
    }
  ]
}
