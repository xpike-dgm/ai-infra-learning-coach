{
  "format": "code_test_suite/1",
  "suite": "codetest.python.conditionals.write_branch_logic.g09@v1",
  "item": "item.python.conditionals.write_branch_logic.g09@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "last_largest",
      "stdin": "5\n1\n9\n",
      "expected_stdout": "9\n"
    },
    {
      "id": "first_largest",
      "stdin": "8\n3\n2\n",
      "expected_stdout": "8\n"
    },
    {
      "id": "middle_largest",
      "stdin": "1\n6\n4\n",
      "expected_stdout": "6\n"
    },
    {
      "id": "tie",
      "stdin": "7\n7\n2\n",
      "expected_stdout": "7\n"
    },
    {
      "id": "negatives",
      "stdin": "-3\n-8\n-5\n",
      "expected_stdout": "-3\n"
    }
  ]
}
