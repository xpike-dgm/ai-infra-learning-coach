{
  "format": "code_test_suite/1",
  "suite": "codetest.python.files_paths_basic.demonstrate_capability.g02@v1",
  "item": "item.python.files_paths_basic.demonstrate_capability.g02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, tempfile, cozum\nfrom pathlib import Path\nicerik = sys.argv[1].replace(\"|\", chr(10))\nwith tempfile.TemporaryDirectory() as d:\n    yol = Path(d) / \"veri.txt\"\n    yol.write_bytes(icerik.encode(\"utf-8\"))\n    print(cozum.kelime_sayisi(yol))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two_lines",
      "args": [
        "bir iki üç|dört beş|"
      ],
      "expected_stdout": "5\n"
    },
    {
      "id": "extra_spaces",
      "args": [
        "  a   b  "
      ],
      "expected_stdout": "2\n"
    },
    {
      "id": "empty",
      "args": [
        ""
      ],
      "expected_stdout": "0\n"
    }
  ]
}
