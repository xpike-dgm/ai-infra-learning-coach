{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.g11@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.g11@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nd = {}\nfor x in sys.argv[2:]:\n    k, v = x.split(\"=\")\n    d[k] = v\nprint(cozum.guzergah(d, sys.argv[1]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "chain",
      "args": [
        "A",
        "A=B",
        "B=C"
      ],
      "expected_stdout": "['A', 'B', 'C']\n"
    },
    {
      "id": "no_next",
      "args": [
        "X",
        "A=B"
      ],
      "expected_stdout": "['X']\n"
    },
    {
      "id": "middle_start",
      "args": [
        "B",
        "A=B",
        "B=C",
        "C=D"
      ],
      "expected_stdout": "['B', 'C', 'D']\n"
    }
  ]
}
