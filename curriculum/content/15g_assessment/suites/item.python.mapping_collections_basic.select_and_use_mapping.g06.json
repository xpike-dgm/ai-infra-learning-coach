{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.g06@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.g06@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nd = {}\nfor x in sys.argv[2:]:\n    k, v = x.split(\"=\")\n    d[k] = int(v)\nprint(cozum.esik_ustu(d, int(sys.argv[1])))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "mixed",
      "args": [
        "50",
        "ali=70",
        "can=45",
        "ece=50"
      ],
      "expected_stdout": "['ali', 'ece']\n"
    },
    {
      "id": "none",
      "args": [
        "100",
        "a=1"
      ],
      "expected_stdout": "[]\n"
    },
    {
      "id": "unsorted_input",
      "args": [
        "0",
        "zeki=5",
        "ayla=0"
      ],
      "expected_stdout": "['ayla', 'zeki']\n"
    }
  ]
}
