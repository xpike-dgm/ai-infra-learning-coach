{
  "format": "code_test_suite/1",
  "suite": "codetest.python.while_termination.write_terminating_loop.g01@v1",
  "item": "item.python.while_termination.write_terminating_loop.g01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "twenty",
      "stdin": "20\n",
      "expected_stdout": "1\n4\n9\n16\n"
    },
    {
      "id": "one",
      "stdin": "1\n",
      "expected_stdout": "1\n"
    },
    {
      "id": "zero",
      "stdin": "0\n",
      "expected_stdout": ""
    },
    {
      "id": "exact_square",
      "stdin": "25\n",
      "expected_stdout": "1\n4\n9\n16\n25\n"
    }
  ]
}
