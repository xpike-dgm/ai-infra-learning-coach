{
  "format": "code_test_suite/1",
  "suite": "codetest.python.tuple_immutable_sequence.demonstrate_capability.g03@v1",
  "item": "item.python.tuple_immutable_sequence.demonstrate_capability.g03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nsonuc = cozum.tek_elemanli(int(sys.argv[1]))\nprint(sonuc, type(sonuc).__name__)"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "eight",
      "args": [
        "8"
      ],
      "expected_stdout": "(8,) tuple\n"
    },
    {
      "id": "negative",
      "args": [
        "-1"
      ],
      "expected_stdout": "(-1,) tuple\n"
    }
  ]
}
