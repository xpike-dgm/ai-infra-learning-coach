{
  "format": "code_test_suite/1",
  "suite": "codetest.python.string_text_operations.demonstrate_capability.g02@v1",
  "item": "item.python.string_text_operations.demonstrate_capability.g02@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.kac_tane(sys.argv[1], sys.argv[2]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "letter",
      "args": [
        "kelebek",
        "e"
      ],
      "expected_stdout": "3\n"
    },
    {
      "id": "syllable",
      "args": [
        "banana",
        "na"
      ],
      "expected_stdout": "2\n"
    },
    {
      "id": "none",
      "args": [
        "masa",
        "z"
      ],
      "expected_stdout": "0\n"
    }
  ]
}
