{
  "format": "code_test_suite/1",
  "suite": "codetest.python.exception_handling.demonstrate_capability.g11@v1",
  "item": "item.python.exception_handling.demonstrate_capability.g11@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two_bad",
      "stdin": "on\n3.5\n7\n",
      "expected_stdout": "geçersiz\ngeçersiz\nSayı: 7\n"
    },
    {
      "id": "first_good",
      "stdin": "12\n",
      "expected_stdout": "Sayı: 12\n"
    },
    {
      "id": "negative",
      "stdin": "x\n-4\n9\n",
      "expected_stdout": "geçersiz\nSayı: -4\n"
    },
    {
      "id": "spaces_around",
      "stdin": "a\n 7 \n",
      "expected_stdout": "geçersiz\nSayı: 7\n"
    },
    {
      "id": "end_of_input_propagates",
      "stdin": "a\nb\n",
      "expected_stdout": "geçersiz\ngeçersiz\n",
      "expected_exit_code": 1
    }
  ]
}
