{
  "format": "code_test_suite/1",
  "suite": "codetest.python.input_output_basic.build_small_io_flow.g11@v1",
  "item": "item.python.input_output_basic.build_small_io_flow.g11@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "example",
      "stdin": "Ece\n2006\n2026\n",
      "expected_stdout": "Sayın Ece, bu yıl 20 yaşına giriyorsun.\n"
    },
    {
      "id": "other",
      "stdin": "Kaan\n1990\n2025\n",
      "expected_stdout": "Sayın Kaan, bu yıl 35 yaşına giriyorsun.\n"
    },
    {
      "id": "same_year",
      "stdin": "Su\n2026\n2026\n",
      "expected_stdout": "Sayın Su, bu yıl 0 yaşına giriyorsun.\n"
    }
  ]
}
