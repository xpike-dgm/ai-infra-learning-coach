{
  "format": "code_test_suite/1",
  "suite": "codetest.python.string_text_operations.demonstrate_capability.g09@v1",
  "item": "item.python.string_text_operations.demonstrate_capability.g09@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.palindrom_mu(sys.argv[1]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "classic",
      "args": [
        "Ey Edip Adanada pide ye"
      ],
      "expected_stdout": "True\n"
    },
    {
      "id": "not_palindrome",
      "args": [
        "Merhaba dunya"
      ],
      "expected_stdout": "False\n"
    },
    {
      "id": "case_only",
      "args": [
        "Kayak"
      ],
      "expected_stdout": "True\n"
    },
    {
      "id": "uneven_spaces",
      "args": [
        "Ab cba"
      ],
      "expected_stdout": "True\n"
    }
  ]
}
