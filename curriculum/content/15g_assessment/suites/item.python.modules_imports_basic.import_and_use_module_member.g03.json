{
  "format": "code_test_suite/1",
  "suite": "codetest.python.modules_imports_basic.import_and_use_module_member.g03@v1",
  "item": "item.python.modules_imports_basic.import_and_use_module_member.g03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.en_sik([int(x) for x in sys.argv[1:]]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "tie_first_wins",
      "args": [
        "1",
        "2",
        "2",
        "3",
        "3"
      ],
      "expected_stdout": "2\n"
    },
    {
      "id": "single",
      "args": [
        "4"
      ],
      "expected_stdout": "4\n"
    },
    {
      "id": "clear",
      "args": [
        "7",
        "7",
        "1"
      ],
      "expected_stdout": "7\n"
    },
    {
      "id": "small_most_common",
      "args": [
        "5",
        "9",
        "9",
        "1",
        "1",
        "1",
        "2"
      ],
      "expected_stdout": "1\n"
    }
  ]
}
