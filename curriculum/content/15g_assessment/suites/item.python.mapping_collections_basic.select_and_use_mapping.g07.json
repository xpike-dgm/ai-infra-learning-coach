{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.g07@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.g07@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(sorted(cozum.uzunluklar(sys.argv[1:]).items()))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two",
      "args": [
        "su",
        "çay"
      ],
      "expected_stdout": "[('su', 2), ('çay', 3)]\n"
    },
    {
      "id": "repeat",
      "args": [
        "ev",
        "ev",
        "okul"
      ],
      "expected_stdout": "[('ev', 2), ('okul', 4)]\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "[]\n"
    }
  ]
}
