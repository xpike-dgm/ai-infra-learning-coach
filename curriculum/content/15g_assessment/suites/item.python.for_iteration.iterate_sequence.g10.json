{
  "format": "code_test_suite/1",
  "suite": "codetest.python.for_iteration.iterate_sequence.g10@v1",
  "item": "item.python.for_iteration.iterate_sequence.g10@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "four_digits",
      "stdin": "1234\n",
      "expected_stdout": "10\n"
    },
    {
      "id": "single",
      "stdin": "7\n",
      "expected_stdout": "7\n"
    },
    {
      "id": "zeros",
      "stdin": "9005\n",
      "expected_stdout": "14\n"
    }
  ]
}
