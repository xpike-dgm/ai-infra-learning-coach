{
  "format": "code_test_suite/1",
  "suite": "codetest.python.files_paths_basic.demonstrate_capability.g04@v1",
  "item": "item.python.files_paths_basic.demonstrate_capability.g04@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, tempfile, cozum\nfrom pathlib import Path\nicerik = sys.argv[1].replace(\"|\", chr(10))\nwith tempfile.TemporaryDirectory() as d:\n    yol = Path(d) / \"veri.txt\"\n    yol.write_bytes(icerik.encode(\"utf-8\"))\n    print(cozum.bos_satir_sayisi(yol))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "one_blank",
      "args": [
        "a||b|"
      ],
      "expected_stdout": "1\n"
    },
    {
      "id": "none",
      "args": [
        "a|b|c"
      ],
      "expected_stdout": "0\n"
    },
    {
      "id": "empty_file",
      "args": [
        ""
      ],
      "expected_stdout": "0\n"
    },
    {
      "id": "blanks_at_end",
      "args": [
        "x|||"
      ],
      "expected_stdout": "2\n"
    }
  ]
}
