{
  "format": "code_test_suite/1",
  "suite": "codetest.python.for_iteration.iterate_sequence.g03@v1",
  "item": "item.python.for_iteration.iterate_sequence.g03@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "cozum.py"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "four",
      "stdin": "4\n",
      "expected_stdout": "****\n"
    },
    {
      "id": "one",
      "stdin": "1\n",
      "expected_stdout": "*\n"
    },
    {
      "id": "zero",
      "stdin": "0\n",
      "expected_stdout": "\n"
    }
  ]
}
