{
  "format": "code_test_suite/1",
  "suite": "codetest.c.standard_io_basic.demonstrate_capability.t01@v1",
  "item": "item.c.standard_io_basic.demonstrate_capability.t01@v1",
  "build": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-o",
      "cozum",
      "cozum.c"
    ]
  },
  "run": {
    "command": [
      "./cozum"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "example",
      "stdin": "17 5\n",
      "expected_stdout": "17 = 5 * 3 + 2\n"
    },
    {
      "id": "exact",
      "stdin": "20 4\n",
      "expected_stdout": "20 = 4 * 5 + 0\n"
    },
    {
      "id": "smaller",
      "stdin": "3 7\n",
      "expected_stdout": "3 = 7 * 0 + 3\n"
    }
  ]
}
