{
  "format": "code_test_suite/1",
  "suite": "codetest.python.mapping_collections_basic.select_and_use_mapping.g01@v1",
  "item": "item.python.mapping_collections_basic.select_and_use_mapping.g01@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nd = {}\nfor x in sys.argv[1:]:\n    k, v = x.split(\"=\")\n    d[k] = int(v)\nprint(cozum.anahtarlar_sirali(d))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "two",
      "args": [
        "muz=3",
        "elma=5"
      ],
      "expected_stdout": "['elma', 'muz']\n"
    },
    {
      "id": "empty",
      "args": [],
      "expected_stdout": "[]\n"
    },
    {
      "id": "three",
      "args": [
        "c=1",
        "a=2",
        "b=3"
      ],
      "expected_stdout": "['a', 'b', 'c']\n"
    }
  ]
}
