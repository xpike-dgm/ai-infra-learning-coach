{
  "format": "code_test_suite/1",
  "suite": "codetest.python.path_handling.read_write_small_text_file.g09@v1",
  "item": "item.python.path_handling.read_write_small_text_file.g09@v1",
  "build": {
    "command": [
      "{python}",
      "-m",
      "py_compile",
      "cozum.py"
    ]
  },
  "run": {
    "command": [
      "{python}",
      "-c",
      "import sys, cozum\nprint(cozum.esi_mi(sys.argv[1], sys.argv[2]))"
    ]
  },
  "timeout_seconds": 5,
  "compare": "trim_trailing_whitespace",
  "tests": [
    {
      "id": "pair",
      "args": [
        "src/ana.c",
        "build/ana.o"
      ],
      "expected_stdout": "True\n"
    },
    {
      "id": "same_suffix",
      "args": [
        "a/x.txt",
        "b/x.txt"
      ],
      "expected_stdout": "False\n"
    },
    {
      "id": "different_stem",
      "args": [
        "ana.c",
        "yan.o"
      ],
      "expected_stdout": "False\n"
    }
  ]
}
